# cmake/TomlFixes.cmake (C27-02) : le configure échoue quand un fichier à corriger manque, et passe avec l'arbre
# complet. Un toml++ livré en un seul toml.hpp amalgamé recevait sinon la marque AJP_TOML_FIXED sans aucun correctif.
# Lancé par CTest : cmake -DSOURCE=<dépôt> -DWORK=<dossier> -DTOML_INCLUDE=<dossier contenant toml++/> -P toml_fixes_test.cmake
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(try_configure name include_dir out_result out_output)
  set(dir "${WORK}/${name}")
  file(MAKE_DIRECTORY "${dir}")
  file(WRITE "${dir}/CMakeLists.txt"
       "cmake_minimum_required(VERSION 3.25)\nproject(toml_fixes NONE)\n"
       "include(\"${SOURCE}/cmake/TomlFixes.cmake\")\najp_toml_fixed_include(\"${include_dir}\" fixed)\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${dir}" -B "${dir}/build" RESULT_VARIABLE result
                  OUTPUT_VARIABLE output ERROR_VARIABLE output)
  set(${out_result} "${result}" PARENT_SCOPE)
  set(${out_output} "${output}" PARENT_SCOPE)
endfunction()

# Un seul toml.hpp : ni impl/parser.inl ni impl/unicode_autogenerated.hpp.
file(COPY "${TOML_INCLUDE}/toml++/toml.hpp" DESTINATION "${WORK}/single/toml++")
try_configure(single "${WORK}/single" result output)
if(result EQUAL 0)
  message(FATAL_ERROR "un toml++ réduit à toml.hpp passe le configure sans correctif")
endif()
if(NOT output MATCHES "ne peuvent pas s'appliquer")
  message(FATAL_ERROR "refus pour une autre raison que les fichiers absents : ${output}")
endif()

# L'arbre complet de la version épinglée.
try_configure(full "${TOML_INCLUDE}" result output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "le toml++ épinglé n'est plus corrigé : ${output}")
endif()
message(STATUS "TomlFixes : refus d'un en-tête unique, arbre complet accepté")
