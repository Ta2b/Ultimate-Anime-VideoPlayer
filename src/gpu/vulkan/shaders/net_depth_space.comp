#version 450
// DepthToSpace et SpaceToDepth, modes DCR (ONNX) et CRD (pixel_shuffle de PyTorch).
// Référence : gpu/ir/op_pixel.cpp (eval_depth_to_space, eval_space_to_depth).
#extension GL_GOOGLE_include_directive : require
#include "net_tensor.glsl"

layout(local_size_x = 256) in;

layout(constant_id = 0) const uint TX = 0;
layout(constant_id = 1) const uint TY = 0;
layout(constant_id = 2) const uint MODE = 0;  // 0 DepthToSpace DCR, 1 DepthToSpace CRD, 2 SpaceToDepth DCR, 3 CRD

AJP_NET_BUFFER(0, src, readonly)
AJP_NET_BUFFER(1, dst, writeonly)

layout(push_constant) uniform Push {
  TDesc x;
  TDesc y;
  uint block;
} pc;

void main() {
  uint i = linear_invocation();
  if (i >= t_count(pc.y)) return;
  uvec4 o = t_coords(pc.y, i);
  uint b = pc.block;
  uint from;
  if (MODE < 2u) {
    uint r = o.z % b;
    uint s = o.w % b;
    uint c = MODE == 0u ? (r * b + s) * pc.y.c + o.y : o.y * b * b + r * b + s;
    from = t_index(pc.x, o.x, c, o.z / b, o.w / b);
  } else {
    uint cell = MODE == 2u ? o.y / pc.x.c : o.y % (b * b);
    uint c = MODE == 2u ? o.y % pc.x.c : o.y / (b * b);
    from = t_index(pc.x, o.x, c, o.z * b + cell / b, o.w * b + cell % b);
  }
  AJP_STORE(dst, TY, t_index(pc.y, o.x, o.y, o.z, o.w), AJP_LOAD(src, TX, from))
}
