// Les paramètres (PARAM) du grade HDR anime (anime-hdr-anime/, anime-hdr-look.hook, anime-hdr-black.hook), déclarés une
// fois ici et lus par render::Grade (src/render/grade.cpp, kGradeParams) ; leurs valeurs viennent de
// render::decide_grade (src/render/grade_params.cpp). Le grade part du shader de
// https://github.com/Ta2b/mpv-AnimeJaNai-HDR (commit 33ff79d) ; seuls restent les paramètres que le grade
// anime lit encore.
//
// L'image arrive sur OUTPUT déjà encodée en PQ BT.2020 pour l'écran. Sur une sortie SDR, elle est en BT.709 au
// gamma sdr_gamma : sdr_tm = 1, les passes 1-local et 3-anime la lisent en PQ (anime-hdr-black la ramène au
// SDR).

//!PARAM peak
//!DESC Pic de sortie (nits)
//!TYPE float
//!MINIMUM 100.0
//!MAXIMUM 10000.0
1000.0

//!PARAM paper
//!DESC Blanc papier : debut des eclats (nits)
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 5000.0
203.0

//!PARAM shadows
//!DESC Profondeur des noirs (0 = neutre)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 0.95
0.30

//!PARAM shadow_knee
//!DESC Fin de la zone des ombres (nits)
//!TYPE float
//!MINIMUM 1.0
//!MAXIMUM 200.0
50.0

//!PARAM spec_gain
//!DESC Gain des eclats isoles au niveau du papier
//!TYPE float
//!MINIMUM 1.0
//!MAXIMUM 20.0
4.3

//!PARAM sdr_white
//!DESC Niveau du blanc SDR a l'entree (nits)
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 1000.0
203.0

//!PARAM sdr_gamma
//!DESC Sortie SDR : exposant du transfert de l'ecran (2,2 sRGB, 2,4 BT.1886)
//!TYPE float
//!MINIMUM 1.8
//!MAXIMUM 2.8
2.2

//!PARAM sdr_tm
//!DESC 1 = sortie SDR de la methode anime : l'image SDR passe en PQ, la courbe du plan la ramene au SDR
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM an_gate_lo
//!DESC Porte des emetteurs : code PQ de 0,55 x le blanc de la source (Grade::write_params)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.5

//!PARAM an_gate_hi
//!DESC Porte des emetteurs : code PQ de 0,95 x le blanc de la source
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.6

//!PARAM an_spark_lo
//!DESC Etincelles : code PQ de 0,6 x le blanc de la source
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.5

//!PARAM an_spark_hi
//!DESC Etincelles : code PQ du blanc de la source
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.6

//!PARAM adapt
//!DESC 1 = blanc de la source a sdr_white, aplats a la moitie du pic (route native) ; 0 = blanc papier
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM chroma
//!DESC Fin du grade : facteur de saturation (1 = identite), mene vers le gamut sans le depasser
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 4.0
1.0

//!PARAM pivot
//!DESC Fin du grade : luminance (nits) ou le contraste ne change rien
//!TYPE float
//!MINIMUM 10.0
//!MAXIMUM 400.0
80.0

//!PARAM an_lift
//!DESC HDR anime : releve fixe des surfaces (le meme dans tous les plans)
//!TYPE float
//!MINIMUM 0.5
//!MAXIMUM 3.0
1.15

//!PARAM an_punch
//!DESC HDR anime : contraste en plus autour du gris des surfaces (0 = aucun, --anime-contrast)
//!TYPE float
//!MINIMUM -1.0
//!MAXIMUM 2.0
0.0

//!PARAM an_chroma
//!DESC HDR anime : facteur de saturation (1 = identite, --anime-saturation)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 2.0
1.0

//!PARAM an_spec
//!DESC HDR anime : part de la montee des eclats (1 = celle du grade, --anime-highlights)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 2.0
1.0

//!PARAM skin_n
//!DESC HDR anime : nombre de teintes de peau des visages du plan (0 = la plage large)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 3.0
0.0

//!PARAM skin_h0
//!DESC HDR anime : teinte (degres) de la peau 1 des visages du plan
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 60.0
0.0

//!PARAM skin_s0
//!DESC HDR anime : saturation de la peau 1 des visages du plan
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM skin_h1
//!DESC HDR anime : teinte (degres) de la peau 2 des visages du plan
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 60.0
0.0

//!PARAM skin_s1
//!DESC HDR anime : saturation de la peau 2 des visages du plan
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM skin_h2
//!DESC HDR anime : teinte (degres) de la peau 3 des visages du plan
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 60.0
0.0

//!PARAM skin_s2
//!DESC HDR anime : saturation de la peau 3 des visages du plan
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM an_late
//!DESC 1 = la montee des emetteurs part dans l'alpha, la derniere passe l'applique apres la pile de LUT
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM video_fps
//!DESC Images video distinctes par seconde a l'ecran (source x interpolation) : les lissages sont en secondes
//!TYPE float
//!MINIMUM 1.0
//!MAXIMUM 1000.0
24.0

//!PARAM fs_apl
//!DESC Grade en une passe : luminance moyenne de la scene (nits a l'ecran), donnee par le lecteur ; < 0 inconnue
//!TYPE float
//!MINIMUM -1.0
//!MAXIMUM 10000.0
-1.0

//!PARAM fs_series
//!DESC Noirs profonds : luminance moyenne de la serie (nits a l'ecran), la mediane des plans connus ; < 0 inconnue
//!TYPE float
//!MINIMUM -1.0
//!MAXIMUM 10000.0
-1.0

//!PARAM black_lo
//!DESC Seuil du vrai noir (nits) : en dessous, le pixel vaut 0
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 50.0
0.0

//!PARAM black_hi
//!DESC Fin du pied (nits) : au-dessus, l'image est inchangée
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 50.0
0.0

//!PARAM kwin_on
//!DESC 1 = l'image porte ses métadonnées HDR (--hdr-metadata) : la compression de KWin est faite ici
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM kwin_ref
//!DESC Luminosité SDR de KDE (nits) : le blanc de référence de l'écran, où KWin pose le blanc PQ de 203 nits
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 1000.0
200.0

//!PARAM kwin_peak
//!DESC Pic de l'écran pour KWin (nits)
//!TYPE float
//!MINIMUM 100.0
//!MAXIMUM 10000.0
1000.0
