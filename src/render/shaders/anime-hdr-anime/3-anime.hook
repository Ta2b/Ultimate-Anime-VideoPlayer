//!HOOK OUTPUT
//!BIND HOOKED
//!BIND AJG_LOCAL
//!BIND AJG_AREAT
//!COMPONENTS 4
//!DESC AnimeJaNai HDR anime - surfaces ancrees, seuls les emetteurs montent

// Le grade HDR du lecteur (methode « HDR anime ») : aucune decision pixel par pixel.
//  - Surfaces : un relevement fixe an_lift (le meme dans tous les plans) : une peau, un mur, une chemise
//    gardent leur niveau d'un plan a l'autre.
//  - Emetteurs : une carte E douce (0 a 1) qui ne depend que de cartes floues (moyenne 8x8 et zone de ~2,5 %
//    de l'image, deja mesurees par les passes 1 et 2) : seule la lumiere (plus claire que son voisinage ET
//    proche du blanc) monte vers la marge des eclats, qui suit la luminosite moyenne de la scene.
//  - Application : un gain lisse multiplie les trois canaux ; le grain, les traits et la teinte gardent leur
//    contraste d'origine (le damier de la peau pale, c'etait le masque pixel par pixel).
//  - Eclats en dernier (an_late, docs/hdr-anime.md) : sur une sortie HDR dont la derniere passe
//    compresse vers l'ecran (anime-hdr-black.hook), la montee des emetteurs n'est pas appliquee ici. La pile de
//    LUT et la compression la divisaient par deux (audit A41-02). Elle part dans le canal alpha, en
//    diaphragmes au-dessus des surfaces, et la derniere passe l'applique apres la pile, sous le pic de
//    l'ecran. Les passes de ce grade gardent donc toutes quatre composantes (COMPONENTS 4).
// Sortie SDR : image inchangee (les surfaces gardent leur niveau).
const vec3 LUMA = vec3(0.2627, 0.6780, 0.0593);

vec3 pq_to_nits(vec3 e) {
    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / 78.84375));
    return 10000.0 * pow(max(p - 0.8359375, 0.0) / max(18.8515625 - 18.6875 * p, 1e-6),
                         vec3(6.27739463));
}
vec3 nits_to_pq(vec3 n) {
    vec3 q = pow(clamp(n / 10000.0, 0.0, 1.0), vec3(0.1593017578125));
    return pow((0.8359375 + 18.8515625 * q) / (1.0 + 18.6875 * q), vec3(78.84375));
}
float pq_of(float nits) { return nits_to_pq(vec3(nits)).x; }

// Epaule douce vers `top` : pente 1 au genou, jamais au-dessus du sommet.
float shoulder(float v, float knee, float top) {
    if (v <= knee) return v;
    float room = max(top - knee, 1e-3);
    return knee + room * (1.0 - exp(-(v - knee) / room));
}

// Pied des noirs sur le maximum RGB (le meme que le grade actuel : shadows, shadow_knee).
float shadow_ratio(float m, float depth) {
    if (m >= shadow_knee) return 1.0;
    float u = 1.0 - m / shadow_knee;
    return 1.0 - depth * u * u;
}

// Teinte de peau (audit F2) : R >= G >= B, teinte de 15 a 45 degres, saturation moderee (0,12 a 0,60 en
// BT.2020 lineaire). Un blanc (saturation < 0,1) et un feu, un neon, un coucher de soleil (> 0,7) n'en sont
// pas. Douce aux bords : 0 hors de la plage, 1 au milieu.
// Peau des visages (option face_skin, media/faces.h) : quand la pre-analyse a trouve des visages dans le plan
// (skin_n > 0), la plage se resserre autour de leurs teintes : 6 degres et 19 % de saturation pleins, rien
// au-dela de 12 degres et 37 %. Une lampe chaude, une bougie, d'une autre teinte que ces visages, redevient
// une lumiere. Sans visage trouve, la plage large reste.
float skin_near(float hue, float sat, float h, float s) {
    float dh = abs(hue - h);
    float ds = abs(log2(max(sat, 1e-4) / max(s, 1e-4)));
    return (1.0 - smoothstep(6.0, 12.0, dh)) * (1.0 - smoothstep(0.25, 0.45, ds));
}
float skin_like(vec3 c) {
    float mx = max(max(c.r, c.g), c.b);
    float mn = min(min(c.r, c.g), c.b);
    if (mx <= 1e-4 || c.r < c.g || c.g < c.b) return 0.0;
    float sat = (mx - mn) / mx;
    float hue = 60.0 * (c.g - c.b) / max(c.r - c.b, 1e-6);
    float wide = smoothstep(10.0, 16.0, hue) * (1.0 - smoothstep(44.0, 52.0, hue)) *
                 smoothstep(0.08, 0.12, sat) * (1.0 - smoothstep(0.60, 0.70, sat));
    if (skin_n < 0.5) return wide;
    float near = skin_near(hue, sat, skin_h0, skin_s0);
    if (skin_n > 1.5) near = max(near, skin_near(hue, sat, skin_h1, skin_s1));
    if (skin_n > 2.5) near = max(near, skin_near(hue, sat, skin_h2, skin_s2));
    return wide * near;
}

// Saturation en Oklab : l'ecart en RVB lineaire a la luminance tournait les bleus vers le violet quand on
// poussait (le bleu BT.2020 n'est pas a teinte constante sur cette droite). Ici, la chroma (a, b) d'Oklab est
// multipliee par k, L garde : la teinte (l'angle de a, b) ne bouge pas. Comme la premiere colonne de
// l'inverse de M2 vaut (1, 1, 1), multiplier a et b par k revient a ecarter les racines cubiques des cones
// (l', m', s') de L, sans passer par Lab. La luminance BT.2020 est ensuite remise a yc par un facteur commun
// (il garde la teinte et la chroma d'Oklab relatives) : le curseur ne change que la couleur, comme avant.
// Hors gamut (un canal negatif), k recule vers 1 par dichotomie : jamais de canal negatif.
const mat3 TO_LMS = mat3(0.6166884418, 0.3601590705, 0.0230432935,
                         0.2651401962, 0.6358564847, 0.0990302336,
                         0.1001506451, 0.2040043234, 0.6963246774);
const mat3 FROM_LMS = mat3(2.1401404110, -1.2463559505, 0.1064317259,
                           -0.8848324528, 2.1631727207, -0.2783615921,
                           -0.0485790580, -0.4544909080, 1.5023562946);
const vec3 OK_L = vec3(0.2104542553, 0.7936177850, -0.0040720468);

vec3 oklab_scaled(vec3 q, float L, float k) {
    vec3 r = vec3(L) + (q - vec3(L)) * k;
    return (r * r * r) * FROM_LMS;
}
vec3 oklab_chroma(vec3 c, float yc, float k) {
    // Racines cubiques des cones (l', m', s'), directement en nits : multiplier c par t multiplie l', m', s'
    // et L par la racine cubique de t, et la sortie par t. Le resultat ne depend pas de l'echelle.
    vec3 q = pow(max(c * TO_LMS, vec3(0.0)), vec3(1.0 / 3.0));
    float L = dot(OK_L, q);
    vec3 out_c = oklab_scaled(q, L, k);
    if (min(min(out_c.r, out_c.g), out_c.b) < 0.0) {
        float lo = 1.0;  // toujours dans le gamut (la couleur d'origine)
        float hi = k;
        for (int i = 0; i < 8; i++) {
            float mid = 0.5 * (lo + hi);
            vec3 t = oklab_scaled(q, L, mid);
            if (min(min(t.r, t.g), t.b) < 0.0) hi = mid; else lo = mid;
        }
        out_c = oklab_scaled(q, L, lo);
    }
    out_c = max(out_c, vec3(0.0));
    float yo = dot(out_c, LUMA);
    return yo > 1e-9 ? out_c * (yc / yo) : c;
}

// Carte locale guidee : la carte 1/8 relevee par un sur-echantillonnage
// bilateral joint, guide par le pixel. Un pixel sombre au bord d'une lumiere lit les blocs sombres, un pixel
// clair les blocs clairs : le halo ne deborde plus d'un demi-bloc sur la surface voisine.
float an_local(float y_pq, float plain) {
    vec2 t = AJG_LOCAL_pos * AJG_LOCAL_size - 0.5;
    vec2 base = floor(t);
    vec2 f = t - base;
    float acc = 0.0;
    float wsum = 0.0;
    for (int j = -1; j <= 2; j++) {
        for (int i = -1; i <= 2; i++) {
            vec2 d = abs(vec2(float(i), float(j)) - f);
            float ws = max(0.0, 1.0 - 0.5 * d.x) * max(0.0, 1.0 - 0.5 * d.y);
            float v = AJG_LOCAL_tex((base + vec2(float(i), float(j)) + 0.5) * AJG_LOCAL_pt).x;
            float r = (v - y_pq) / 0.06;
            float w = ws * (exp(-r * r) + 1e-4);
            acc += w * v;
            wsum += w;
        }
    }
    return wsum > 0.0 ? acc / wsum : plain;
}
vec4 hook() {
    vec4 px = HOOKED_tex(HOOKED_pos);
    // Le niveau du blanc de la source : le blanc SDR (203) pour la route native (adapt), sinon le blanc papier
    // (decide_grade pose paper = 0,5 x pic sur la route native : ce n'est alors pas le blanc de la source).
    float white = adapt > 0.5 ? sdr_white : paper;
    vec3 lin = pq_to_nits(px.rgb);
    float y = max(dot(lin, LUMA), 1e-4);
    float y_pq = pq_of(y);

    // Cartes floues : niveau du bloc (8x8, bilineaire) et de la zone (~2,5 % de l'image).
    float local_bilin = AJG_LOCAL_tex(AJG_LOCAL_pos).x;  // en PQ, comme toute la carte
    float local_pq = an_local(y_pq, local_bilin);
    float area_pq = AJG_AREAT_tex(AJG_AREAT_pos).x;
    float base = max(pq_to_nits(vec3(local_pq)).x, 1e-3);

    // Carte des emetteurs : plus clair que le voisinage, et proche du blanc SDR (porte sur le niveau du bloc :
    // un aplat sombre plus clair que son entourage n'est pas une lumiere).
    float iso = smoothstep(0.05, 0.25, local_pq - area_pq);
    // C41-03 : les seuils ne dependent que des parametres, calcules une fois par Grade::write_params.
    float gate = smoothstep(an_gate_lo, an_gate_hi, local_pq);
    // Audit F2 : une peau n'est jamais une lumiere. Une peau claire pres d'un fond sombre gardait la porte
    // ouverte et s'eclairait comme une lampe au bord des visages. La teinte et la saturation ne dependent pas
    // de la luminance : le grain d'une peau ne fait pas osciller la porte (pas de damier).
    gate *= 1.0 - skin_like(lin);
    // Etincelle de 1 a 4 px : le pixel domine nettement son bloc (bien au-dela du grain), et il est proche du
    // blanc. La porte compare des codes PQ (y_pq) : y, en nits, la laissait ouverte des 1 nit.
    float spark = smoothstep(0.08, 0.20, y_pq - local_bilin) * smoothstep(an_spark_lo, an_spark_hi, y_pq);
    // P3.53 : la peau n'est pas plus une etincelle qu'une lumiere, et un blanc serre entre deux traits noirs
    // (texte cerne, trait fin) non plus. Le noir d'un trait (sous 1 % du blanc) a 2 px de part et d'autre
    // ferme la porte ; le ciel d'une nuit, plus clair, la laisse ouverte aux etoiles.
    vec2 d2 = 2.0 * HOOKED_pt;
    float lx = min(dot(pq_to_nits(HOOKED_tex(HOOKED_pos - vec2(d2.x, 0.0)).rgb), LUMA),
                   dot(pq_to_nits(HOOKED_tex(HOOKED_pos + vec2(d2.x, 0.0)).rgb), LUMA));
    float ly = min(dot(pq_to_nits(HOOKED_tex(HOOKED_pos - vec2(0.0, d2.y)).rgb), LUMA),
                   dot(pq_to_nits(HOOKED_tex(HOOKED_pos + vec2(0.0, d2.y)).rgb), LUMA));
    float inked = 1.0 - smoothstep(0.004 * white, 0.015 * white, min(lx, ly));
    spark *= (1.0 - skin_like(lin)) * (1.0 - inked);
    float emitter = max(iso * gate, spark);

    // Marge des eclats : le pic en scene sombre, la moitie en scene tres claire (limiteur de l'OLED).
    float key = clamp((fs_apl >= 0.0 ? fs_apl : 0.15 * white) / sdr_white, 0.0, 1.0);
    float p_hl = peak * mix(1.0, 0.5, smoothstep(0.30, 0.70, key));
    float lvl = max(base, y * spark);
    // Le curseur Eclats (an_spec, 1 : la methode telle quelle) agit meme quand l'ancien curseur des eclats
    // (spec_gain) est a 0 : au-dessus de 100 %, les lumieres montent jusqu'a 2,5 fois de plus a 200 % ; en
    // dessous, elles redescendent jusqu'a 25 % sous les surfaces a 0 %.
    float boost = (spec_gain - 1.0) * an_spec +
                  (an_spec >= 1.0 ? 1.5 * (an_spec - 1.0) : -0.25 * (1.0 - an_spec));
    float emit_out = lvl * (1.0 + smoothstep(0.5 * white, white, lvl) * boost);
    bool late = an_late > 0.5;
    // Eclats en dernier : ni epaule ni limiteur ici, la derniere passe les pose sur le niveau de l'ecran.
    if (!late) emit_out = shoulder(emit_out, 0.65 * p_hl, p_hl);
    float floor_gain = an_lift * (an_spec >= 1.0 ? 1.0 : mix(0.75, 1.0, an_spec));
    float gain = mix(an_lift, max(emit_out / lvl, floor_gain), emitter);
    // La montee de l'emetteur au-dessus des surfaces, en diaphragmes (de -2 a +6), dans l'alpha : 0,75 moins
    // un huitieme par diaphragme. Un alpha de 1 ne se produit jamais : la derniere passe le lit comme « rien ».
    px.a = late ? clamp(0.75 - log2(gain / an_lift) / 8.0, 0.0, 0.98) : 1.0;

    vec3 c = lin * (late ? an_lift : gain);
    // Noirs profonds selon la serie (P3.52) : le curseur est le maximum, atteint dans une serie tres claire ;
    // l'effet descend a 0 dans une serie tres sombre. La cle de la serie ne bouge pas aux coupes : les memes
    // cheveux sombres sortent au meme niveau d'un plan a l'autre. Serie inconnue : une cle moyenne (0,25).
    float series = clamp((fs_series >= 0.0 ? fs_series : 0.25 * sdr_white) / sdr_white, 0.0, 1.0);
    float deep = shadows * smoothstep(0.03, 0.40, series);
    c *= shadow_ratio(max(max(c.r, c.g), c.b), deep);
    // Peps (--anime-contrast, --anime-saturation) : contraste en puissance de la luminance autour du gris des
    // surfaces, puis saturation (chroma d'Oklab, luminance et teinte gardees, attenuee vers le pic, jamais de
    // canal negatif).
    // Identite exacte a an_punch = 0 et an_chroma = 1. Eclats en dernier (B41-02) : un emetteur est ici a son
    // niveau de surface ; la courbe et l'attenuation se calculent au niveau ou il montera (rise), comme
    // quand la montee s'appliquait ici, pour que le peps le traite en lumiere et non en surface.
    float rise = late ? gain / an_lift : 1.0;
    float yc = dot(c, LUMA);
    if (yc > 1e-4 && an_punch != 0.0) {
        float pivot = 0.4 * white;
        float yt = yc * rise;
        float x = yt / pivot;
        float shaped = pivot * pow(x, 1.0 + an_punch * (x >= 1.0 ? 0.55 : 0.40));
        c *= shaped / yt;
        yc *= shaped / yt;
    }
    if (yc > 1e-4 && an_chroma != 1.0) {
        float k = 1.0 + (an_chroma - 1.0) * (1.0 - 0.6 * smoothstep(0.35 * peak, peak, yc * rise));
        c = oklab_chroma(c, yc, k);
    }
    // Garde-fou : jamais au-dessus du pic, teinte gardee.
    float m = max(max(c.r, c.g), c.b);
    if (m > 1e-4) c *= shoulder(m, 0.80 * peak, peak) / m;
    px.rgb = nits_to_pq(c);
    return px;
}
