//!HOOK OUTPUT
//!BIND HOOKED
//!BIND AJG_LOCAL
//!BIND AJG_AREAT
//!DESC AnimeJaNai HDR anime - surfaces ancrees, seuls les emetteurs montent

// Methode « HDR anime » (--hdr-anime), a cote du grade actuel : aucune decision pixel par pixel.
//  - Surfaces : un relevement fixe an_lift (le meme dans tous les plans) : une peau, un mur, une chemise
//    gardent leur niveau d'un plan a l'autre.
//  - Emetteurs : une carte E douce (0 a 1) qui ne depend que de cartes floues (moyenne 8x8 et zone de ~2,5 %
//    de l'image, deja mesurees par les passes 1 et 2) : seule la lumiere (plus claire que son voisinage ET
//    proche du blanc) monte vers la marge des eclats, qui suit la luminosite moyenne de la scene.
//  - Application : un gain lisse multiplie les trois canaux ; le grain, les traits et la teinte gardent leur
//    contraste d'origine (le damier de la peau pale, c'etait le masque pixel par pixel).
// Sortie SDR : image inchangee (les surfaces gardent leur niveau).
const vec3 LUMA = vec3(0.2627, 0.6780, 0.0593);

vec3 pq_to_nits(vec3 e) {
    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / 78.84375));
    return 10000.0 * pow(max(p - 0.8359375, 0.0) / max(18.8515625 - 18.6875 * p, 1e-6),
                         vec3(6.27739463));
}
vec3 nits_to_pq(vec3 n) {
    vec3 q = pow(clamp(n / 10000.0, 0.0, 1.0), vec3(0.1593017578125));
    return pow((0.8359375 + 18.8515625 * q) / (1.0 + 18.6875 * q), vec3(78.84375));
}
float pq_of(float nits) { return nits_to_pq(vec3(nits)).x; }

// Epaule douce vers `top` : pente 1 au genou, jamais au-dessus du sommet.
float shoulder(float v, float knee, float top) {
    if (v <= knee) return v;
    float room = max(top - knee, 1e-3);
    return knee + room * (1.0 - exp(-(v - knee) / room));
}

// Pied des noirs sur le maximum RGB (le meme que le grade actuel : shadows, shadow_knee).
float shadow_ratio(float m, float depth) {
    if (m >= shadow_knee) return 1.0;
    float u = 1.0 - m / shadow_knee;
    return 1.0 - depth * u * u;
}

vec4 hook() {
    vec4 px = HOOKED_tex(HOOKED_pos);
    if (sdr_out > 0.5) return px;
    // Le niveau du blanc de la source : le blanc SDR (203) pour l'aspect adaptatif (adapt), sinon le blanc papier
    // (decide_grade pose paper = 0,5 x pic dans l'aspect adaptatif : ce n'est alors pas le blanc de la source).
    float white = adapt > 0.5 ? sdr_white : paper;
    vec3 lin = pq_to_nits(px.rgb);
    float y = max(dot(lin, LUMA), 1e-4);
    float y_pq = pq_of(y);

    // Cartes floues : niveau du bloc (8x8, bilineaire) et de la zone (~2,5 % de l'image).
    float local_pq = AJG_LOCAL_tex(AJG_LOCAL_pos).x;
    float area_pq = AJG_AREAT_tex(AJG_AREAT_pos).x;
    float base = max(pq_to_nits(vec3(local_pq)).x, 1e-3);

    // Carte des emetteurs : plus clair que le voisinage, et proche du blanc SDR (porte sur le niveau du bloc :
    // un aplat sombre plus clair que son entourage n'est pas une lumiere).
    float iso = smoothstep(0.05, 0.25, local_pq - area_pq);
    float gate = smoothstep(pq_of(0.55 * white), pq_of(0.95 * white), local_pq);
    // Etincelle de 1 a 4 px : le pixel domine nettement son bloc (bien au-dela du grain).
    float spark = smoothstep(0.08, 0.20, y_pq - local_pq) * smoothstep(pq_of(0.6 * white), pq_of(white), y);
    float emitter = max(iso * gate, spark);

    // Marge des eclats : le pic en scene sombre, la moitie en scene tres claire (limiteur de l'OLED).
    float key = clamp((fs_apl >= 0.0 ? fs_apl : 0.15 * white) / sdr_white, 0.0, 1.0);
    float p_hl = peak * mix(1.0, 0.5, smoothstep(0.30, 0.70, key));
    float lvl = max(base, y * spark);
    float emit_out = lvl * (1.0 + smoothstep(0.5 * white, white, lvl) * (spec_gain - 1.0));
    emit_out = shoulder(emit_out, 0.65 * p_hl, p_hl);
    float gain = mix(an_lift, max(emit_out / lvl, an_lift), emitter);

    vec3 c = lin * gain;
    c *= shadow_ratio(max(max(c.r, c.g), c.b), shadows);
    // Garde-fou : jamais au-dessus du pic, teinte gardee.
    float m = max(max(c.r, c.g), c.b);
    if (m > 1e-4) c *= shoulder(m, 0.80 * peak, peak) / m;
    px.rgb = nits_to_pq(c);
    return px;
}
