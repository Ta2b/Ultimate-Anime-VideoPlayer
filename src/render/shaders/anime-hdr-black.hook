// AnimeJaNai HDR - les dernières passes du grade, propres à ce dépôt, posées sur OUTPUT après le grade
// (anime-hdr-anime/) et le look (anime-hdr-look.hook), sur l'image encodée en PQ BT.2020.
//
// 1. Vrai noir OLED (deux passes, quand black_hi > black_lo) :
//   m = max(maxRGB du pixel, AJG_LOCALMAX), en nits ; AJG_LOCALMAX est le max 8x8 de maxRGB,
//       échantillonné en bilinéaire : un pixel de bruit isolé ne clignote pas d'une image à
//       l'autre, et les bords de blocs ne marquent pas ;
//   gain = smoothstep(black_lo, black_hi, m) : 0 sous black_lo (le pixel vaut 0), puis un pied
//       C1 qui rejoint l'identité à black_hi (sortie = m × gain : pente 0 au noir, 1 à black_hi) ;
//   R, G et B reçoivent le même gain : la teinte ne bouge pas. Le tramage de libplacebo suit.
//   Les deux passes sautent quand black_hi <= black_lo, donc aussi quand black_hi vaut 0 (le
//   défaut) : l'image reste alors identique, octet pour octet.
// 2. Sortie HDR (kwin_on) : la compression vers le pic de l'écran, puis les éclats, appliqués en dernier.
// 3. Sortie SDR de la méthode anime (sdr_tm) : le PQ ramené au SDR par la courbe du plan.
//
// Sortie SDR sans la méthode anime (sdr_out = 1, comme le grade) : l'image est en BT.709 gamma sdr_gamma,
// son blanc à `peak` nits ; le pied du vrai noir s'applique sur les nits ainsi décodés.
//
// Toutes les passes sur HOOKED gardent quatre composantes (COMPONENTS 4) : l'alpha porte la montée des
// émetteurs de la passe anime jusqu'à la sortie HDR (3-anime.hook, an_late).

//!PARAM black_lo
//!DESC Seuil du vrai noir (nits) : en dessous, le pixel vaut 0
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 50.0
0.0

//!PARAM black_hi
//!DESC Fin du pied (nits) : au-dessus, l'image est inchangée
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 50.0
0.0

//!PARAM sdr_out
//!DESC 1 = sortie SDR BT.709 (gamma sdr_gamma, blanc à peak nits), 0 = PQ BT.2020
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM sdr_gamma
//!DESC Sortie SDR : exposant du transfert de l'écran
//!TYPE float
//!MINIMUM 1.8
//!MAXIMUM 2.8
2.2

//!PARAM peak
//!DESC Sortie SDR : blanc de l'image (nits)
//!TYPE float
//!MINIMUM 100.0
//!MAXIMUM 10000.0
1000.0

//!PARAM kwin_on
//!DESC 1 = l'image porte ses métadonnées HDR (--hdr-metadata) : la compression vers l'écran est faite ici
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM kwin_ref
//!DESC Luminosité SDR de KDE (nits) : le blanc de référence de l'écran, où KWin pose le blanc PQ de 203 nits
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 1000.0
200.0

//!PARAM kwin_peak
//!DESC Pic de l'écran (nits affichés) : rien ne sort au-dessus
//!TYPE float
//!MINIMUM 100.0
//!MAXIMUM 10000.0
1000.0

//!PARAM kwin_curve
//!DESC Sommet de la courbe de compression (nits affichés) : le pic de l'écran, l'identité sans pile
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 100000.0
1000.0

//!PARAM kwin_gain
//!DESC Facteur sur la sortie de la courbe (« Blanc des surfaces » sous Reinhard seul) : 1, sauf là
//!TYPE float
//!MINIMUM 0.05
//!MAXIMUM 1.0
1.0

//!PARAM kwin_full
//!DESC Sommet de la courbe à « Blanc des surfaces » 100 % (nits affichés) : le niveau d'où partent les éclats
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 100000.0
1000.0

//!PARAM em_top
//!DESC Plafond des éclats (nits affichés) : le pic de l'écran, la dalle limite les scènes claires
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 10000.0
1000.0

//!HOOK OUTPUT
//!BIND HOOKED
//!SAVE AJG_LOCALMAX
//!WIDTH HOOKED.w 8 /
//!HEIGHT HOOKED.h 8 /
//!COMPONENTS 1
//!WHEN black_hi black_lo >
//!DESC AnimeJaNai HDR - vrai noir, max local 8x8

// Max de maxRGB sur le bloc 8x8 du texel, en code PQ (croissant avec les nits).
vec4 hook() {
    ivec2 size = ivec2(HOOKED_size);
    ivec2 base = ivec2(HOOKED_pos * HOOKED_size) - ivec2(4);
    float m = 0.0;
    for (int j = 0; j < 8; j++)
    for (int i = 0; i < 8; i++) {
        ivec2 p = clamp(base + ivec2(i, j), ivec2(0), size - ivec2(1));
        vec3 c = texelFetch(HOOKED_raw, p, 0).rgb;
        m = max(m, max(c.r, max(c.g, c.b)));
    }
    return vec4(m, 0.0, 0.0, 1.0);
}

//!HOOK OUTPUT
//!BIND HOOKED
//!BIND AJG_LOCALMAX
//!COMPONENTS 4
//!WHEN black_hi black_lo >
//!DESC AnimeJaNai HDR - vrai noir OLED

float ajb_pq_to_nits(float e) {
    if (sdr_out > 0.5) return pow(clamp(e, 0.0, 1.0), sdr_gamma) * peak;
    float p = pow(clamp(e, 0.0, 1.0), 1.0 / 78.84375);
    return 10000.0 * pow(max(p - 0.8359375, 0.0) / max(18.8515625 - 18.6875 * p, 1e-6), 6.27739463);
}
vec3 ajb_pq_to_nits3(vec3 e) {
    if (sdr_out > 0.5) return pow(clamp(e, 0.0, 1.0), vec3(sdr_gamma)) * peak;
    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / 78.84375));
    return 10000.0 * pow(max(p - 0.8359375, 0.0) / max(18.8515625 - 18.6875 * p, 1e-6),
                         vec3(6.27739463));
}
vec3 ajb_nits_to_pq3(vec3 n) {
    if (sdr_out > 0.5) return pow(clamp(n / peak, 0.0, 1.0), vec3(1.0 / sdr_gamma));
    vec3 q = pow(clamp(n / 10000.0, 0.0, 1.0), vec3(0.1593017578125));
    return pow((0.8359375 + 18.8515625 * q) / (1.0 + 18.6875 * q), vec3(78.84375));
}

// Le pied d'un pixel encodé `e`, `local_pq` le max local 8x8.
vec3 ajb_black(vec3 e, float local_pq) {
    float m = ajb_pq_to_nits(max(max(e.r, max(e.g, e.b)), local_pq));
    if (m >= black_hi)
        return e;
    float gain = smoothstep(black_lo, black_hi, m);
    return ajb_nits_to_pq3(ajb_pq_to_nits3(e) * gain);
}

vec4 hook() {
    vec4 px = HOOKED_tex(HOOKED_pos);
    px.rgb = ajb_black(px.rgb, AJG_LOCALMAX_tex(AJG_LOCALMAX_pos).x);
    return px;
}

//!HOOK OUTPUT
//!BIND HOOKED
//!COMPONENTS 4
//!WHEN kwin_on
//!DESC AnimeJaNai HDR - compression vers l'écran, puis les éclats

// La sortie HDR annonce son vrai maximum (--hdr-metadata) : le compositeur n'a plus rien à compresser, et
// cette passe ramène la pile de LUT à l'écran. La pile a été réglée à l'œil sous la compression que KWin
// faisait sans métadonnées (Reinhard modifié sur l'intensité ICtCp, de 10 000 nits vers le pic,
// colormanagement.glsl de KWin) : la même courbe sert ici, son sommet (kwin_curve) au pic de l'écran. Le
// blanc d'une surface sort là où la pile le porte, vers 70 % du pic (render/output_tune.h). Sans pile, la
// courbe est l'identité : rien n'est compressé (A41-04).
// Les éclats viennent ensuite (docs/hdr-anime.md) : la montée des émetteurs, que la passe anime a laissée dans
// l'alpha, s'applique ici, après la pile, sous le plafond em_top (le pic de l'écran). Leur écart sur les
// surfaces ne dépend donc ni des curseurs de la pile ni de la courbe, qui le divisaient par deux (A41-02).
// L'image est en PQ BT.2020 ; le compositeur pose le blanc PQ (203 nits) à kwin_ref : k = kwin_ref / 203.
const mat3 AJK_TO_LMS = mat3(1688.0, 683.0, 99.0, 2146.0, 2951.0, 309.0, 262.0, 462.0, 3688.0) / 4096.0;

vec3 ajk_pq_to_lin(vec3 e) {
    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / 78.84375));
    return pow(max(p - 0.8359375, 0.0) / max(18.8515625 - 18.6875 * p, 1e-6), vec3(6.27739463));
}
vec3 ajk_lin_to_pq(vec3 l) {
    vec3 q = pow(clamp(l, 0.0, 1.0), vec3(0.1593017578125));
    return pow((0.8359375 + 18.8515625 * q) / (1.0 + 18.6875 * q), vec3(78.84375));
}

// La compression d'un pixel encodé vers le sommet `curve` : ses nits affichés (blanc de référence à
// kwin_ref), avant l'écrêtage.
vec3 ajk_compress(vec3 e, float curve) {
    float k = kwin_ref / 203.0;
    // Ce que l'écran recevrait, en nits affichés, divisé par 10 000.
    vec3 lms = AJK_TO_LMS * (ajk_pq_to_lin(e) * k);
    vec3 lms_pq = ajk_lin_to_pq(lms);
    float intensity = 0.5 * (lms_pq.x + lms_pq.y);
    float luminance = ajk_pq_to_lin(vec3(intensity)).x * 10000.0;
    float rel = max(luminance / kwin_ref, 0.0);
    float in_range = 10000.0 * k / kwin_ref;
    float out_range = curve / kwin_ref;
    float v = (out_range * (1.0 + in_range) - in_range) / (in_range * in_range);
    rel = rel * (1.0 + rel * v) / (1.0 + rel);
    float mapped = ajk_lin_to_pq(vec3(rel * kwin_ref / 10000.0)).x;
    // ICtCp : Ct et Cp gardés, l'intensité changée ; L', M' et S' bougent ensemble de cet écart.
    vec3 out_lms = ajk_pq_to_lin(lms_pq + (mapped - intensity)) * 10000.0;
    return max(inverse(AJK_TO_LMS) * out_lms, 0.0);
}

// Le niveau d'un émetteur : `m` (le maximum RVB de la surface, nits affichés) monté de `gain`. Au-dessus
// des surfaces, une épaule douce vers le plafond `top` à partir de 65 % de celui-ci (ou du niveau de la
// surface s'il est déjà plus haut) : jamais sous la surface, jamais au-dessus du plafond qu'elle n'atteint
// pas seule. Un gain sous 1 (curseur Éclats sous 100 %) baisse le niveau tel quel.
float ajk_emit(float m, float gain, float top) {
    float v = m * gain;
    if (gain <= 1.0) return v;
    if (m >= top) return m;
    float knee = max(0.65 * top, m);
    if (v <= knee) return v;
    float room = max(top - knee, 1e-3);
    return knee + room * (1.0 - exp(-(v - knee) / room));
}

// B41-01 : « Blanc des surfaces » sous 100 % baisse la courbe (kwin_curve, kwin_gain), mais un émetteur part
// du niveau qu'il aurait sous la courbe à 100 % (kwin_full) : baisser les surfaces ne baisse pas les éclats.
// La part d'émetteur va de 0 (aucune montée) à 1 dès un demi-diaphragme, sans marche (le même calcul :
// render::emitter_over_surface).
float ajk_emit_over(vec3 e, float m, float gain) {
    float base = m;
    if (gain > 1.0 && kwin_full != kwin_curve) {
        vec3 f = ajk_compress(e, kwin_full);
        float m_full = max(f.r, max(f.g, f.b));
        base = mix(m, max(m_full, m), smoothstep(0.0, 0.5, log2(gain)));
    }
    return ajk_emit(base, gain, em_top);
}

vec4 hook() {
    vec4 px = HOOKED_tex(HOOKED_pos);
    vec3 n = ajk_compress(px.rgb, kwin_curve) * kwin_gain;
    // L'alpha de la passe anime : 0,75 moins un huitième par diaphragme de montée ; 1 : rien à appliquer.
    if (px.a < 0.99) {
        float m = max(n.r, max(n.g, n.b));
        if (m > 1e-4) n *= ajk_emit_over(px.rgb, m, exp2((0.75 - px.a) * 8.0)) / m;
    }
    // Ramené au signal : le compositeur multipliera par k, sans plus rien compresser.
    px.rgb = ajk_lin_to_pq(min(n, kwin_peak) / (kwin_ref / 203.0 * 10000.0));
    px.a = 1.0;
    return px;
}

//!PARAM sdr_tm
//!DESC 1 = sortie SDR de la methode anime : la derniere passe ramene le PQ au SDR, courbe du plan
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM tm_white
//!DESC Sortie SDR de la methode anime : les nits des surfaces, poses au blanc SDR
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 2000.0
233.0

//!PARAM tm_top
//!DESC Sortie SDR de la methode anime : la marge des eclats du plan (nits), posee juste sous le blanc
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 10000.0
1000.0

//!HOOK OUTPUT
//!BIND HOOKED
//!COMPONENTS 4
//!WHEN sdr_tm
//!DESC AnimeJaNai HDR anime - PQ vers SDR, courbe du plan

// Le rendu HDR (grade anime et pile de LUT) ramene au SDR sans toucher aux couleurs : sur le maximum RGB
// (la teinte reste), identite jusqu'a 90 % du blanc des surfaces (tm_white), puis un Reinhard etendu qui pose
// la marge des eclats du plan (tm_top) au blanc SDR. P3.60 : le genou etait a 70 %, un blanc de surface
// sortait a 85 % (gris clair) ; a 90 %, il sort a 95 %, et les eclats gardent les derniers 5 %. Les couleurs
// hors du BT.709 vont vers leur luminance.
const mat3 AJT_2020_TO_709 = mat3( 1.6604910, -0.1245505, -0.0181508,
                                  -0.5876411,  1.1328999, -0.1005789,
                                  -0.0728499, -0.0083494,  1.1187297);

float ajt_curve(float x, float top) {
    const float k = 0.90;
    if (x <= k) return x;
    float u = (x - k) / (1.0 - k);
    float ut = max((top - k) / (1.0 - k), 1.001);
    float v = u * (1.0 + u / (ut * ut)) / (1.0 + u);
    return k + (1.0 - k) * min(v, 1.0);
}

vec4 hook() {
    vec4 px = HOOKED_tex(HOOKED_pos);
    vec3 p = pow(clamp(px.rgb, 0.0, 1.0), vec3(1.0 / 78.84375));
    vec3 n = 10000.0 * pow(max(p - 0.8359375, 0.0) / max(18.8515625 - 18.6875 * p, 1e-6), vec3(6.27739463));
    vec3 c = AJT_2020_TO_709 * n / tm_white;
    float y = dot(c, vec3(0.2126, 0.7152, 0.0722));
    float lo = min(c.r, min(c.g, c.b));
    if (lo < 0.0) c = y > 0.0 ? vec3(y) + (c - vec3(y)) * (y / (y - lo)) : vec3(0.0);
    float m = max(c.r, max(c.g, c.b));
    if (m > 1e-6) c *= ajt_curve(m, tm_top / tm_white) / m;
    px.rgb = pow(clamp(c, 0.0, 1.0), vec3(1.0 / sdr_gamma));
    px.a = 1.0;
    return px;
}
