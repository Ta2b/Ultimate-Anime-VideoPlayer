// Origine : https://github.com/Ta2b/mpv-AnimeJaNai-HDR, commit 33ff79d (vu à c6fee61),
// BuildMpvUpscale2xAnimeJaNai/mpv-upscale-2x_animejanai/portable_config/user-shaders/anime-hdr-grade.hook,
// copié sous cet en-tête. Seul ajout de ce dépôt : le garde-fou des couleurs saturées (`guard`,
// préréglage « Éclatant ») ; à guard = 0, le défaut, le shader calcule exactement comme l'original.
//
// AnimeJaNai HDR grade - un seul shader pour RTX TrueHDR et le HDR MPV (NVIDIA / AMD / Intel).
//
// Pose sur OUTPUT : l'image est deja encodee en PQ BT.2020 pour l'ecran.
// Le controleur user-scripts/animejanai_hdr_auto.lua l'attache seulement
// quand la sortie PQ est confirmee, et lui transmet les parametres ci-dessous.
// Ajout de ce depot : sur une sortie SDR (sdr_out = 1), l'image est en BT.709 gamma sdr_gamma,
// son blanc place a `peak` nits ; le meme traitement s'y applique dans le gamut BT.709, sans
// marge au-dessus du blanc. A sdr_out = 0, le defaut, rien ne change.
// Ajout de ce depot : le HDR adaptatif (adapt = 1, route native, tous GPU) module l'aspect TrueHDR
// emule par la scene : APL lisse et part des grands aplats clairs freinent l'expansion vers le
// pic (eblouissement, limiteur OLED), une scene de nuit adoucit le contraste des ombres. A
// adapt = 0, le defaut, rien ne change.
//
// Traitement par pixel, en lumiere lineaire absolue (nits) :
//   1. noirs : pied de courbe doux sous `shadow_knee`, le noir reste a 0 ;
//   2. eclats : gain au-dessus du blanc papier, fort pour les zones plus
//      lumineuses que leur voisinage (eclats, reflets, magie, neons), faible
//      pour les grands aplats clairs (ciel, murs blancs) et jamais module
//      sur la peau (pas de taches claires ni de scintillement sur les visages) ;
//   3. epaule douce vers `peak`, sans ecretage dur ;
//   4. vibrance perceptuelle ICtCp, tons chair exclus, couleurs deja saturees menagees ;
//   5. limite douce au gamut de l'ecran (P3) et au pic.
// Les canaux RGB sont multiplies ensemble aux etapes 1 a 3 : la teinte ne bouge pas.
//
// Stabilite : la carte de zone est lissee d'une image a l'autre (buffer persistant) et
// remise a zero a chaque changement de plan. Limiteur OLED (ABL) : sur une scene tres
// claire, l'ecran baisse de toute facon sa luminosite ; les gains y sont moderes.

//!PARAM peak
//!DESC Pic de sortie (nits)
//!TYPE float
//!MINIMUM 100.0
//!MAXIMUM 10000.0
1000.0

//!PARAM paper
//!DESC Blanc papier : debut des eclats (nits)
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 5000.0
203.0

//!PARAM in_max
//!DESC Niveau maximal attendu en entree (nits) : papier pour le SDR converti par MPV, pic pour TrueHDR
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 10000.0
203.0

//!PARAM shadows
//!DESC Profondeur des noirs (0 = neutre)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 0.95
0.30

//!PARAM shadow_knee
//!DESC Fin de la zone des ombres (nits)
//!TYPE float
//!MINIMUM 1.0
//!MAXIMUM 200.0
50.0

//!PARAM area_gain
//!DESC Gain des grands aplats lumineux au niveau du papier
//!TYPE float
//!MINIMUM 1.0
//!MAXIMUM 4.0
1.4

//!PARAM spec_gain
//!DESC Gain des eclats isoles au niveau du papier
//!TYPE float
//!MINIMUM 1.0
//!MAXIMUM 20.0
4.3

//!PARAM vibrance
//!DESC Vibrance perceptuelle (0 = neutre)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.4
0.25

//!PARAM abl
//!DESC Moderation des eclats sur les scenes claires (limiteur OLED), 0 = aucune
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM abl_lo
//!DESC Limiteur OLED : APL lisse (nits) ou la moderation commence
//!TYPE float
//!MINIMUM 20.0
//!MAXIMUM 2000.0
80.0

//!PARAM abl_hi
//!DESC Limiteur OLED : APL lisse (nits) ou la moderation est complete
//!TYPE float
//!MINIMUM 20.0
//!MAXIMUM 2000.0
250.0

//!PARAM expand
//!DESC Couleurs etendues : couleurs BT.709 saturees vers les primaires P3 (0 = aucune)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM gamut_p3
//!DESC 1 = limiter au gamut Display P3 de l'ecran, 0 = conteneur BT.2020
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
1.0

//!PARAM guard
//!DESC Garde-fou des couleurs saturees : epaule douce du canal le plus fort vers le pic (0 = coupe nette)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM emulate
//!DESC 1 = aspect RTX TrueHDR applique au SDR converti par MPV (sortie SDR : jusqu'a son blanc)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM sdr_white
//!DESC Aspect TrueHDR : niveau du blanc SDR a l'entree (nits)
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 1000.0
203.0

//!PARAM em_base
//!DESC Aspect TrueHDR : echelle des tons moyens (4 x gris moyen)
//!TYPE float
//!MINIMUM 40.0
//!MAXIMUM 400.0
200.0

//!PARAM em_pow
//!DESC Aspect TrueHDR : exposant de la montee vers le pic (6 au gris moyen 50)
//!TYPE float
//!MINIMUM 2.0
//!MAXIMUM 16.0
6.0

//!PARAM em_lo
//!DESC Aspect TrueHDR : exposant du contraste sous le pivot
//!TYPE float
//!MINIMUM 0.5
//!MAXIMUM 2.0
1.0

//!PARAM em_hi
//!DESC Aspect TrueHDR : exposant du contraste au-dessus du pivot
//!TYPE float
//!MINIMUM 0.5
//!MAXIMUM 2.0
1.0

//!PARAM em_sat
//!DESC Aspect TrueHDR : facteur de saturation
//!TYPE float
//!MINIMUM 0.5
//!MAXIMUM 1.5
1.0

//!PARAM sdr_out
//!DESC 1 = sortie SDR BT.709 (gamma sdr_gamma, blanc a peak nits), 0 = PQ BT.2020
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM sdr_gamma
//!DESC Sortie SDR : exposant du transfert de l'ecran (2,2 sRGB, 2,4 BT.1886)
//!TYPE float
//!MINIMUM 1.8
//!MAXIMUM 2.8
2.2

//!PARAM adapt
//!DESC 1 = HDR adaptatif : l'aspect TrueHDR emule suit la scene (APL, aplats clairs), 0 = courbe fixe
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0


//!PARAM punch
//!DESC Fin du grade : contraste en courbe de puissance autour du pivot (0 = identite, negatif = adouci)
//!TYPE float
//!MINIMUM -1.0
//!MAXIMUM 4.0
0.0

//!PARAM chroma
//!DESC Fin du grade : facteur de saturation (1 = identite), mene vers le gamut sans le depasser
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 4.0
1.0

//!PARAM pivot
//!DESC Fin du grade : luminance (nits) ou le contraste ne change rien
//!TYPE float
//!MINIMUM 10.0
//!MAXIMUM 400.0
80.0

//!PARAM ad_on
//!DESC 1 = grade adaptatif : noirs et vibrance suivent la luminosite moyenne de la scene (0 = curseurs fixes)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM ad_lo
//!DESC Grade adaptatif : APL lisse (nits) en dessous duquel la scene est « sombre » (les curseurs)
//!TYPE float
//!MINIMUM 1.0
//!MAXIMUM 2000.0
12.0

//!PARAM ad_hi
//!DESC Grade adaptatif : APL lisse (nits) au-dessus duquel la scene est « claire » (valeurs ad_*)
//!TYPE float
//!MINIMUM 2.0
//!MAXIMUM 4000.0
110.0

//!PARAM ad_shadows
//!DESC Grade adaptatif : profondeur des noirs d'une scene claire
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 0.95
0.80

//!PARAM ad_vibrance
//!DESC Grade adaptatif : vibrance d'une scene tres claire
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.4
0.0
