
//!BUFFER AJG_AREA_STATE
//!VAR float history[32768]
//!STORAGE

//!HOOK OUTPUT
//!BIND AJG_LOCAL
//!BIND AJG_AREA_STATE
//!SAVE AJG_AREAT
//!WIDTH AJG_LOCAL.w 4 /
//!HEIGHT AJG_LOCAL.h 4 /
//!COMPONENTS 1
//!COMPUTE 16 16
//!DESC AnimeJaNai HDR grade - zone 1/32, flou et lissage temporel en une passe

// Les trois passes de zone du grade d'avant en une : la moyenne 4x4 de la carte locale (1/32 de l'image),
// la gaussienne sigma = 3 texels (environ 2,5 % de l'image) en memoire partagee, puis le lissage temporel
// (~0,1 s, quelle que soit la cadence). Sans plan coupe par le shader : un texel qui change de plus de
// 0,12 en PQ (une coupe, un saut) repart de sa mesure, sans trainee.
const float W[8] = float[8](0.1346, 0.1273, 0.1078, 0.0816, 0.0553, 0.0336, 0.0182, 0.0088);
shared float a0[30][30];
shared float ah[30][16];

void hook() {
    ivec2 size = imageSize(out_image);
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 16 - 7;
    uint tid = gl_LocalInvocationIndex;
    for (uint i = tid; i < 900u; i += 256u) {
        ivec2 q = clamp(origin + ivec2(int(i % 30u), int(i / 30u)), ivec2(0), size - 1);
        vec2 pos = (vec2(q) + 0.5) / vec2(size);
        float acc = 0.0;
        for (int j = 0; j < 2; j++)
        for (int k = 0; k < 2; k++)
            acc += AJG_LOCAL_tex(pos + vec2(float(k) * 2.0 - 1.0, float(j) * 2.0 - 1.0) * AJG_LOCAL_pt).x;
        a0[i / 30u][i % 30u] = acc * 0.25;
    }
    barrier();
    for (uint i = tid; i < 480u; i += 256u) {
        uint y = i / 16u, x = i % 16u + 7u;
        float acc = a0[y][x] * W[0];
        for (uint k = 1u; k < 8u; k++) acc += (a0[y][x - k] + a0[y][x + k]) * W[k];
        ah[y][x - 7u] = acc;
    }
    barrier();
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;
    uvec2 l = gl_LocalInvocationID.xy;
    float value = ah[l.y + 7u][l.x] * W[0];
    for (uint k = 1u; k < 8u; k++) value += (ah[l.y + 7u - k][l.x] + ah[l.y + 7u + k][l.x]) * W[k];
    int idx = p.y * size.x + p.x;
    if (idx < 32768) {
        // L'historique garde la valeur + 1 : 0, jamais ecrit.
        float kept = history[idx];
        if (kept > 0.5 && abs(kept - 1.0 - value) <= 0.12)
            value = mix(kept - 1.0, value, 1.0 - pow(0.7, 48.0 / max(video_fps, 1.0)));
        history[idx] = value + 1.0;
    }
    imageStore(out_image, p, vec4(value, 0.0, 0.0, 1.0));
}
