// AnimeJaNai HDR - look (LUT 3D .cube) : la passe qui suit le grade et précède le vrai noir, propre à ce dépôt.
// Posée sur OUTPUT, sur l'image déjà encodée (PQ BT.2020 ; ou BT.709 gamma sdr_gamma en sortie SDR).
//
// Une LUT .cube est faite pour une image d'écran SDR, BT.709, encodée en gamma (blanc = 1). L'image est donc
// ramenée à ce domaine :
//   - en nits, puis en BT.709 linéaire, le blanc de référence `look_white` (203 nits en HDR, le blanc de l'image en
//     SDR) valant 1 ;
//   - ce qui dépasse le blanc (éclats HDR) ne passe pas par la LUT : la couleur est divisée par son maximum quand
//     celui-ci dépasse 1, passe par la LUT, puis est remultipliée. La teinte du look s'applique, l'éclat reste ;
//   - l'entrée de la LUT est encodée par le gamma `look_gamma` (2,4 : BT.1886) ;
//   - le résultat est mélangé à l'image d'origine, en lumière linéaire, par `look_mix` (0 : passe sautée, image
//     identique octet pour octet ; 1 : le look entier).
// Le bloc de texture AJG_LUT est ajouté derrière ce texte à l'exécution (cube_lut.h) ; sans LUT, une identité 2x2x2.

//!PARAM look_mix
//!DESC Intensité du look (0 = aucun, 1 = entier)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM look_size
//!DESC Points par axe de la LUT
//!TYPE float
//!MINIMUM 2.0
//!MAXIMUM 65.0
2.0

//!PARAM look_white
//!DESC Blanc de référence de la LUT (nits)
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 1000.0
203.0

//!PARAM look_pq
//!DESC 1 = la LUT attend du PQ BT.2020 (étalonnée pour l'HDR), 0 = SDR BT.709 en gamma
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM look_gamma
//!DESC Gamma de l'entrée de la LUT
//!TYPE float
//!MINIMUM 1.8
//!MAXIMUM 3.0
2.4

//!PARAM sdr_out
//!DESC 1 = sortie SDR BT.709 (gamma sdr_gamma, blanc à peak nits), 0 = PQ BT.2020
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM sdr_gamma
//!DESC Sortie SDR : exposant du transfert de l'écran
//!TYPE float
//!MINIMUM 1.8
//!MAXIMUM 2.8
2.2

//!PARAM peak
//!DESC Sortie SDR : blanc de l'image (nits)
//!TYPE float
//!MINIMUM 100.0
//!MAXIMUM 10000.0
1000.0

//!HOOK OUTPUT
//!BIND HOOKED
//!BIND AJG_LUT
//!WHEN look_mix 0 >
//!DESC AnimeJaNai HDR - look (LUT 3D)

const mat3 AJL_2020_TO_709 = mat3( 1.6604910, -0.1245505, -0.0181508,
                                  -0.5876411,  1.1328999, -0.1005789,
                                  -0.0728499, -0.0083494,  1.1187297);
const mat3 AJL_709_TO_2020 = mat3( 0.6274040,  0.0690970,  0.0163916,
                                   0.3292820,  0.9195400,  0.0880132,
                                   0.0433136,  0.0113612,  0.8955950);

vec3 ajl_decode(vec3 e) {
    if (sdr_out > 0.5) return pow(clamp(e, 0.0, 1.0), vec3(sdr_gamma)) * peak;
    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / 78.84375));
    return 10000.0 * pow(max(p - 0.8359375, 0.0) / max(18.8515625 - 18.6875 * p, 1e-6), vec3(6.27739463));
}
vec3 ajl_encode(vec3 n) {
    if (sdr_out > 0.5) return pow(clamp(n / peak, 0.0, 1.0), vec3(1.0 / sdr_gamma));
    vec3 q = pow(clamp(n / 10000.0, 0.0, 1.0), vec3(0.1593017578125));
    return pow((0.8359375 + 18.8515625 * q) / (1.0 + 18.6875 * q), vec3(78.84375));
}

vec4 hook() {
    vec4 px = HOOKED_tex(HOOKED_pos);
    if (look_pq > 0.5 && sdr_out < 0.5) {
        // LUT d'HDR : elle lit directement les codes PQ BT.2020 de l'image et rend des codes PQ.
        vec3 pos = (clamp(px.rgb, 0.0, 1.0) * (look_size - 1.0) + 0.5) / look_size;
        px.rgb = mix(px.rgb, clamp(AJG_LUT_tex(pos).rgb, 0.0, 1.0), look_mix);
        return px;
    }
    vec3 nits = ajl_decode(px.rgb);
    // Linéaire BT.709, blanc de référence = 1 (la sortie SDR est déjà en BT.709).
    vec3 lin = (sdr_out > 0.5 ? nits : AJL_2020_TO_709 * nits) / look_white;
    lin = max(lin, 0.0);
    float over = max(max(lin.r, max(lin.g, lin.b)), 1.0);
    vec3 enc = pow(lin / over, vec3(1.0 / look_gamma));
    // Centre des texels : (x * (N - 1) + 0.5) / N.
    vec3 pos = (enc * (look_size - 1.0) + 0.5) / look_size;
    vec3 graded = pow(max(AJG_LUT_tex(pos).rgb, 0.0), vec3(look_gamma)) * over;
    vec3 mixed = mix(lin, graded, look_mix) * look_white;
    px.rgb = ajl_encode(sdr_out > 0.5 ? mixed : AJL_709_TO_2020 * mixed);
    return px;
}
