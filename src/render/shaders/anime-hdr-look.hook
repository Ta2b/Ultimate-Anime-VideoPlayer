// AnimeJaNai HDR - look (LUT 3D .cube) : la passe qui suit le grade et précède le vrai noir, propre à ce dépôt.
// Posée sur OUTPUT, sur l'image déjà encodée en PQ BT.2020 (une sortie SDR y passe aussi : sdr_tm).
//
// Une LUT .cube est faite pour une image d'écran SDR, BT.709, encodée en gamma (blanc = 1). L'image est donc
// ramenée à ce domaine :
//   - en nits, puis en BT.709 linéaire, le blanc de référence `look_white` (203 nits en HDR, le blanc de l'image en
//     SDR) valant 1 ;
//   - ce qui dépasse le blanc (éclats HDR) ne passe pas par la LUT : la couleur est divisée par son maximum quand
//     celui-ci dépasse 1, passe par la LUT, puis est remultipliée. La teinte du look s'applique, l'éclat reste ;
//   - l'entrée de la LUT est encodée par le gamma `look_gamma` (2,4 : BT.1886) ;
//   - jusqu'à vingt LUT s'enchaînent dans cet ordre (comme les nœuds de Resolve), chacune lue telle quelle et
//     mélangée à son entrée par sa propre intensité (look_mix, look_mix2 ... look_mix20 ; 0 : la LUT est sautée) ;
//     toutes à 0 : passe sautée (look_on), image identique octet pour octet. Une seule LUT d'HDR (look_pq) met
//     toute la chaîne en codes PQ. La pile n'est pas réduite à une table : entre deux points, une table
//     interpole la pile entière au lieu de la parcourir (audit A41-01).
// Les intensités, les textures et la chaîne sont écrites à l'exécution aux marques LOOK (render/grade.cpp) ; les
// blocs de texture AJG_LUT suivent ce texte, un par LUT distincte.

//!PARAM look_mix
//!DESC Intensité du look (0 = aucun, 1 = entier)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//@LOOK_PARAMS@

//!PARAM look_on
//!DESC 1 = une LUT au moins s'applique (posé par le lecteur ; l'expression de WHEN ne tient pas vingt intensités)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM look_white
//!DESC Blanc de référence de la LUT (nits)
//!TYPE float
//!MINIMUM 50.0
//!MAXIMUM 1000.0
203.0

//!PARAM look_pq
//!DESC 1 = la LUT attend du PQ BT.2020 (étalonnée pour l'HDR), 0 = SDR BT.709 en gamma
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM look_clean
//!DESC 1 = la pile sur la couleur du voisinage : grain et paliers gardent leur contraste d'origine
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM look_toe
//!DESC Pied adouci de la pile d'HDR : le blanc relevé de la source (nits) ; 0 = la pile telle quelle
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1000.0
0.0

//!PARAM look_gamma
//!DESC Gamma de l'entrée de la LUT
//!TYPE float
//!MINIMUM 1.8
//!MAXIMUM 3.0
2.4

//!HOOK OUTPUT
//!BIND HOOKED
//@LOOK_BINDS@
//!WHEN look_on
//!COMPONENTS 4
//!COMPUTE 16 16
//!DESC AnimeJaNai HDR - look (LUT 3D)

const mat3 AJL_2020_TO_709 = mat3( 1.6604910, -0.1245505, -0.0181508,
                                  -0.5876411,  1.1328999, -0.1005789,
                                  -0.0728499, -0.0083494,  1.1187297);
const mat3 AJL_709_TO_2020 = mat3( 0.6274040,  0.0690970,  0.0163916,
                                   0.3292820,  0.9195400,  0.0880132,
                                   0.0433136,  0.0113612,  0.8955950);

vec3 ajl_decode(vec3 e) {
    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / 78.84375));
    return 10000.0 * pow(max(p - 0.8359375, 0.0) / max(18.8515625 - 18.6875 * p, 1e-6), vec3(6.27739463));
}
vec3 ajl_encode(vec3 n) {
    vec3 q = pow(clamp(n / 10000.0, 0.0, 1.0), vec3(0.1593017578125));
    return pow((0.8359375 + 18.8515625 * q) / (1.0 + 18.6875 * q), vec3(78.84375));
}

//@LOOK_CHAIN@

// Le look d'un pixel encodé en PQ BT.2020, lu par les passes de ce hook seulement ; grade.cpp n'y
// insère que la pile (marque LOOK_CHAIN).
vec3 ajl_look(vec3 e) {
    if (look_pq > 0.5) {
        // LUT d'HDR : elle lit directement les codes PQ BT.2020 de l'image et rend des codes PQ.
        vec3 graded = ajl_chain(e);
        if (look_toe <= 0.0) return graded;
        // Pied adouci (audit A41-03, docs/hdr-anime.md). La LUT de base rendait noir tout ce qui est
        // sous RVB 16 (0,30 nit rendu à 0,02) : les détails des nuits disparaissaient. Sous RVB 48 (là où la
        // pile vaut presque l'identité), l'image quitte la pile pour un pied de pente 1,3 en log (la pile en
        // avait 2), teinte gardée ; la pile reprend toute sa part entre RVB 32 et RVB 48. Le noir pur reste
        // un vrai noir : 0 sous RVB 4, pied entier dès RVB 8. Les seuils sont les codes 8 bits d'une source
        // au gamma 2,4, sur le maximum RVB : (c / 255)^2,4 × look_toe. Même calcul : render/output_tune.h.
        vec3 lin = ajl_decode(e);
        float m = max(lin.r, max(lin.g, lin.b));
        float join = 1.8167e-2 * look_toe;  // RVB 48
        if (m >= join) return graded;
        float toe = join * pow(max(m, 1e-9) / join, 1.3) *
                    smoothstep(4.6693e-5 * look_toe, 2.4644e-4 * look_toe, m);  // RVB 4 et RVB 8
        float pile = smoothstep(log(6.8654e-3 * look_toe), log(join), log(max(m, 1e-9)));  // RVB 32
        return ajl_encode(mix(lin * (toe / max(m, 1e-9)), ajl_decode(graded), pile));
    }
    vec3 nits = ajl_decode(e);
    // Linéaire BT.709, blanc de référence = 1.
    vec3 lin = AJL_2020_TO_709 * nits / look_white;
    lin = max(lin, 0.0);
    float over = max(max(lin.r, max(lin.g, lin.b)), 1.0);
    vec3 enc = pow(lin / over, vec3(1.0 / look_gamma));
    vec3 graded = pow(max(ajl_chain(enc), 0.0), vec3(look_gamma)) * over;
    vec3 out_lin = graded * look_white;
    return ajl_encode(AJL_709_TO_2020 * out_lin);
}
//@LOOK_END@

// Audit F1 (--clean-looks) : la pile étire le grain des ombres (×1,4 à ×2) et les petites variations des
// peaux et des aplats clairs (×3 à 3,5), et les paliers 8 bits avec. Le pixel est ramené à la luminance de
// son voisinage (3 × 3 points tous les 6 pixels, moyenne linéaire), passe par la pile, puis retrouve son écart
// relatif tel quel : la pile donne la couleur et le niveau du voisinage, le grain et les paliers gardent leur
// contraste d'origine. Les bords francs (écart > 20 %) gardent la pile entière ; transition douce entre les
// deux. Coût : la pile une fois par pixel dans les aplats (w = 1 : la pile du pixel n'y compte pas, elle n'est
// pas lue, B41-06) et sur les bords francs (w = 0) ; deux fois entre les deux seulement. L'image est la même
// qu'avec deux traversées partout.
// Passe de calcul en tuiles de 16 × 16 : la luminance de chaque pixel de la tuile et de sa marge de 6 pixels
// est décodée une fois, en mémoire partagée (28 × 28 = 784 décodages pour 256 pixels), au lieu de neuf
// décodages par pixel. Les points lus sont les mêmes (bord de l'image : le texel du bord, comme la lecture
// bornée de la texture) : l'image ne change pas.
float ajl_luma(vec3 n) {
    return max(dot(n, vec3(0.2627, 0.6780, 0.0593)), 1e-4);
}

shared float ajl_y[28][28];

void hook() {
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 16;
    if (look_clean > 0.5) {
        for (uint i = gl_LocalInvocationIndex; i < 784u; i += 256u) {
            vec2 q = vec2(origin + ivec2(int(i % 28u), int(i / 28u)) - 6);
            ajl_y[i / 28u][i % 28u] = ajl_luma(ajl_decode(HOOKED_tex((q + 0.5) * HOOKED_pt).rgb));
        }
        barrier();
    }
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= imageSize(out_image).x || p.y >= imageSize(out_image).y) return;
    vec4 px = HOOKED_tex((vec2(p) + 0.5) * HOOKED_pt);
    float w = 0.0;  // la part de la pile du voisinage
    vec3 lin = vec3(0.0);
    float r = 1.0;
    if (look_clean > 0.5) {
        lin = ajl_decode(px.rgb);
        uvec2 l = gl_LocalInvocationID.xy + 6u;
        float y = ajl_y[l.y][l.x];
        float yb = 0.0;
        for (int j = -1; j <= 1; j++)
            for (int i = -1; i <= 1; i++)
                yb += ajl_y[int(l.y) + 6 * j][int(l.x) + 6 * i];
        r = y / max(yb / 9.0, 1e-4);
        w = 1.0 - smoothstep(0.06, 0.20, abs(log(r)));
    }
    vec3 clean = w > 0.0 ? ajl_encode(ajl_decode(ajl_look(ajl_encode(lin / r))) * r) : px.rgb;
    if (w >= 1.0) {
        px.rgb = clean;
    } else {
        vec3 graded = ajl_look(px.rgb);
        px.rgb = w > 0.0 ? mix(graded, clean, w) : graded;
    }
    imageStore(out_image, p, px);
}
