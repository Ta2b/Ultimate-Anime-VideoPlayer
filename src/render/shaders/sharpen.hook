// AJP - netteté : un masque flou adaptatif sur SCALED, après SPAN et le filtre final vers la fenêtre.
// Propre à ce dépôt. Le détail (le pixel moins la moyenne de ses quatre voisins) est ajouté, réduit près
// des extrêmes du voisinage (comme un renforcement adaptatif au contraste) : les traits nets ne prennent
// qu'un liseré borné (un quart de l'écart local au plus) et les aplats restent lisses. Le lecteur ne pose pas ce hook à force 0 : l'image reste alors
// identique, octet pour octet.
//
// Le domaine (A41-06) : le détail se mesure toujours sur des valeurs encodées (gamma ou PQ), jamais en lumière
// linéaire. SCALED reçoit l'image en linéaire ou encodée selon que libplacebo a linéarisé pour son filtre ;
// la première passe, sur LINEAR, l'y oblige pour toute source SDR (une source HDR n'est jamais linéarisée),
// et `sharpen_linear` dit à la seconde laquelle des deux elle reçoit. Avant, la même force donnait un liseré
// différent en plein écran et en fenêtre réduite.

//!PARAM sharpness
//!DESC Force de la netteté (0 = aucune, 1 = la plus forte)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
0.0

//!PARAM sharpen_linear
//!DESC SCALED en lumière linéaire (source SDR) ou encodé (source HDR)
//!TYPE float
//!MINIMUM 0.0
//!MAXIMUM 1.0
1.0

//!HOOK LINEAR
//!BIND HOOKED
//!SAVE AJP_SHARPEN_LINEAR
//!WIDTH 1
//!HEIGHT 1
//!DESC AJP netteté (domaine fixe)

// Un seul pixel, jamais relu : la présence d'un hook sur LINEAR suffit à faire linéariser libplacebo.
vec4 hook() {
  return vec4(0.0);
}

//!HOOK SCALED
//!BIND HOOKED
//!DESC AJP netteté (masque flou adaptatif)

// Linéaire vers gamma 2,2 et retour, signe gardé (un filtre à lobes négatifs sort de 0 à 1) ; rien sur une
// source HDR, déjà encodée.
vec3 encoded(vec3 v) {
  return sharpen_linear > 0.5 ? sign(v) * pow(abs(v), vec3(1.0 / 2.2)) : v;
}
vec3 decoded(vec3 v) {
  return sharpen_linear > 0.5 ? sign(v) * pow(abs(v), vec3(2.2)) : v;
}

vec4 hook() {
  vec4 c = HOOKED_texOff(vec2(0.0, 0.0));
  c.rgb = encoded(c.rgb);
  vec3 n = encoded(HOOKED_texOff(vec2(0.0, -1.0)).rgb);
  vec3 s = encoded(HOOKED_texOff(vec2(0.0, 1.0)).rgb);
  vec3 e = encoded(HOOKED_texOff(vec2(1.0, 0.0)).rgb);
  vec3 w = encoded(HOOKED_texOff(vec2(-1.0, 0.0)).rgb);
  vec3 lo = min(c.rgb, min(min(n, s), min(e, w)));
  vec3 hi = max(c.rgb, max(max(n, s), max(e, w)));
  // La marge vers 0 et vers 1, relative au plus clair du voisinage : faible sur un trait contrasté.
  vec3 room = sqrt(clamp(min(lo, 1.0 - hi) / max(hi, vec3(1e-4)), 0.0, 1.0));
  vec3 detail = c.rgb - 0.25 * (n + s + e + w);
  // P3.67 : sur un faible contraste local (le grain d'un aplat sombre, ou un aplat clair), le détail n'est
  // que du bruit : la netteté s'éteint sous 1 % d'écart dans le voisinage, entière au-delà de 4 %.
  vec3 contrast = smoothstep(vec3(0.01), vec3(0.04), hi - lo);
  vec3 sharp = c.rgb + 4.0 * sharpness * room * contrast * detail;
  // Un dépassement borné à une fraction de l'écart local : pas de liseré clair ou sombre.
  vec3 pad = 0.25 * (hi - lo);
  return vec4(decoded(clamp(sharp, lo - pad, hi + pad)), c.a);
}
