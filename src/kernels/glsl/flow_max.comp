#version 450
// Mouvement « maximal » d'un mouvement dans sa fenêtre (gpu/kernel_ops.h, flow_max_now) : le plus
// grand |déplacement| des quatre plans du flot, par point, compté dans un histogramme de 256 cases
// de 1/4 de pixel (spec/warp.h, kFlowBins) ; un histogramme par groupe en mémoire partagée, ajouté
// à result[0..255] remis à zéro par l'enregistrement. L'hôte en tire le percentile 99,9 %. NaN
// compte pour 0.
// Référence : kernels/ref/warp.cpp (flow_max) ; même calcul que warp_kernels.cu (flow_max).
#extension GL_GOOGLE_include_directive : require
#include "tensor.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer Flow { AJP_TENSOR v[]; } flow;
layout(std430, binding = 1) buffer Result { uint v[]; } result;

layout(push_constant) uniform Push {
  uint plane_width;
  uint plane_height;
  uint area_x;
  uint area_y;
  uint area_width;
  uint area_height;
} pc;

shared uint group_bins[256];

void main() {
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  uint tid = gl_LocalInvocationIndex;
  group_bins[tid] = 0u;
  barrier();
  if (x < pc.area_width && y < pc.area_height) {
    float m = 0.0;
    uint plane = pc.plane_width * pc.plane_height;
    uint i = (pc.area_y + y) * pc.plane_width + pc.area_x + x;
    for (uint c = 0u; c < 4u; ++c) {
      float v = abs(float(flow.v[c * plane + i]));
      m = v > m ? v : m;  // NaN ne gagne jamais
    }
    float scaled = m * 4.0;
    atomicAdd(group_bins[scaled >= 255.0 ? 255u : uint(scaled)], 1u);
  }
  barrier();
  if (group_bins[tid] != 0u) atomicAdd(result.v[tid], group_bins[tid]);
}
