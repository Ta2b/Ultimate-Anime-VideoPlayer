#version 450
// Mesures d'une paire RGB (gpu/kernel_ops.h, scores_now) : un groupe par bloc 32 × 32, tronqué
// aux bords. Y = 0,2126 R + 0,7152 G + 0,0722 B (BT.709 sur le RGB), s = Σ |Ya − Yb| réduite en
// mémoire partagée ; sums[bloc] reçoit s, et le pire bloc tronque(s / n × levels × 256) passe par
// un atomicMax sur worst[0], remis à zéro par l'enregistrement avant chaque exécution.
// Même calcul que rife_kernels.cu (pair_diff).
#extension GL_GOOGLE_include_directive : require
#include "tensor.glsl"
#include "ajp_kernels_spec.glsl"

const uint AJP_GROUP_X = 32u;
const uint AJP_GROUP_Y = 8u;
const uint AJP_GROUP_SIZE = AJP_GROUP_X * AJP_GROUP_Y;
const uint AJP_BLOCK = uint(AJP_HELD_BLOCK);

layout(local_size_x = AJP_GROUP_X, local_size_y = AJP_GROUP_Y) in;

layout(std430, binding = 0) readonly buffer ImageA { AJP_TENSOR v[]; } a;
layout(std430, binding = 1) readonly buffer ImageB { AJP_TENSOR v[]; } b;
layout(std430, binding = 2) writeonly buffer Sums { float v[]; } sums;
layout(std430, binding = 3) buffer Worst { uint v[]; } worst;

layout(push_constant) uniform Push {
  uint width;
  uint height;
  float levels;  // pas de luma 8 bits entre noir et blanc : 219 limitée, 255 pleine
} pc;

shared float partial[AJP_GROUP_SIZE];

float luma_a(uint plane, uint i) {
  return 0.2126 * float(a.v[i]) + 0.7152 * float(a.v[plane + i]) + 0.0722 * float(a.v[2u * plane + i]);
}

float luma_b(uint plane, uint i) {
  return 0.2126 * float(b.v[i]) + 0.7152 * float(b.v[plane + i]) + 0.0722 * float(b.v[2u * plane + i]);
}

void main() {
  uint x0 = gl_WorkGroupID.x * AJP_BLOCK;
  uint y0 = gl_WorkGroupID.y * AJP_BLOCK;
  uint x1 = min(x0 + AJP_BLOCK, pc.width);
  uint y1 = min(y0 + AJP_BLOCK, pc.height);
  uint plane = pc.width * pc.height;
  float sum = 0.0;
  for (uint y = y0 + gl_LocalInvocationID.y; y < y1; y += AJP_GROUP_Y) {
    for (uint x = x0 + gl_LocalInvocationID.x; x < x1; x += AJP_GROUP_X) {
      uint i = y * pc.width + x;
      sum += abs(luma_a(plane, i) - luma_b(plane, i));
    }
  }
  uint tid = gl_LocalInvocationIndex;
  partial[tid] = sum;
  barrier();
  for (uint n = AJP_GROUP_SIZE / 2u; n > 0u; n >>= 1u) {
    if (tid < n) partial[tid] += partial[tid + n];
    barrier();
  }
  if (tid != 0u) return;
  sums.v[gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x] = partial[0];
  float mean = partial[0] / float((x1 - x0) * (y1 - y0));
  atomicMax(worst.v[0], uint(mean * pc.levels * 256.0));
}
