#version 450
// Les plans constants de l'entrée de RIFE (vsmlrt get_rife_input), écrits dans le tenseur à
// 11 plans à leurs indices de spec/rife.h : instant t, grilles X et Y, multiplicateurs
// 2 / (pw − 1) et 2 / (ph − 1). L'entrée v2 (7 plans) n'a que l'instant. Les images a et b
// s'y écrivent par rife_frames.comp. L'instant se lit dans un mot de paramètre, que le backend
// réécrit d'une exécution à l'autre sans réenregistrer (planes = 7 : l'instant seul, rife_time).
// Référence : kernels/ref/rife.cpp (rife_constant_planes, rife_input).
// Repris de animejanai-inference-rtx@118c272 src/kernels.cu:629-644 (k_rife_consts).
#extension GL_GOOGLE_include_directive : require
#include "tensor.glsl"
#include "ajp_kernels_spec.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) writeonly buffer Input { AJP_TENSOR v[]; } input_planes;
layout(std430, binding = 1) readonly buffer Params { float t; } params;

layout(push_constant) uniform Push {
  uint width;   // pw, multiple de 64
  uint height;  // ph, multiple de 64
  uint planes;  // 11, ou 7 : l'instant seul (v2, ou rife_time)
} pc;

// rife_mesh(i, n) = 2 i / (n − 1) − 1.
float rife_mesh(uint i, uint n) {
  precise float m = 2.0 * float(i) / float(n - 1u) - 1.0;
  return m;
}

void store(int channel, uint i, float value) {
  input_planes.v[uint(channel) * pc.width * pc.height + i] = AJP_TENSOR(value);
}

void main() {
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  if (x >= pc.width || y >= pc.height) return;
  uint i = y * pc.width + x;
  store(AJP_RIFE_CHANNEL_TIME, i, params.t);
  if (pc.planes < uint(AJP_RIFE_INPUT_CHANNELS)) return;
  store(AJP_RIFE_CHANNEL_MESH_X, i, rife_mesh(x, pc.width));
  store(AJP_RIFE_CHANNEL_MESH_Y, i, rife_mesh(y, pc.height));
  store(AJP_RIFE_CHANNEL_STEP_X, i, 2.0 / float(pc.width - 1u));
  store(AJP_RIFE_CHANNEL_STEP_Y, i, 2.0 / float(pc.height - 1u));
}
