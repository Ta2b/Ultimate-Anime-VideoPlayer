#version 450
// Coupe de scène : Σ |a − b| × scene_norm(format) sur deux plans de luma, réduite par groupe de
// travail en mémoire partagée. Chaque groupe écrit sa somme partielle ; l'hôte les additionne
// en double, puis divise par l'aire remplie de RIFE (l'ordre de la réduction est libre :
// tolerance::kSceneScoreRelative). Aucun atomique flottant.
// Contrat : kernels/spec/detect.h ; référence : kernels/ref/detect.cpp (scene_diff_sum).
// Repris de animejanai-inference-rtx@118c272 src/kernels.cu:698-722 (k_scd_diff).
#extension GL_GOOGLE_include_directive : require
#include "ajp_kernels_spec.glsl"
#include "common.glsl"
#include "yuv.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const uint AJP_GROUP_SIZE = 256u;

layout(std430, binding = 0) readonly buffer LumaA { uint words[]; } a;
layout(std430, binding = 1) readonly buffer LumaB { uint words[]; } b;
layout(std430, binding = 2) writeonly buffer Partials { float sum[]; } partials;

layout(push_constant) uniform Push {
  uint a_offset;
  uint a_pitch;
  uint b_offset;
  uint b_pitch;
  uint width;
  uint height;
} pc;

shared float partial[AJP_GROUP_SIZE];

float scene_norm() {
  if (AJP_FORMAT == AJP_FORMAT_NV12) return AJP_SCENE_NORM_NV12;
  if (AJP_FORMAT == AJP_FORMAT_P010) return AJP_SCENE_NORM_P010;
  if (AJP_FORMAT == AJP_FORMAT_P016) return AJP_SCENE_NORM_P016;
  if (AJP_FORMAT == AJP_FORMAT_YUV420P) return AJP_SCENE_NORM_YUV420P;
  if (AJP_FORMAT == AJP_FORMAT_YUV420P10) return AJP_SCENE_NORM_YUV420P10;
  return AJP_SCENE_NORM_YUV444P16;
}

void main() {
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  uint tid = gl_LocalInvocationIndex;
  float d = 0.0;
  if (x < pc.width && y < pc.height) {
    uint byte_a = sample_byte(pc.a_offset, pc.a_pitch, x, y);
    uint byte_b = sample_byte(pc.b_offset, pc.b_pitch, x, y);
    float va = float(sample_in_word(a.words[byte_a >> 2], byte_a));
    float vb = float(sample_in_word(b.words[byte_b >> 2], byte_b));
    precise float term = abs(va - vb) * scene_norm();
    d = term;
  }
  partial[tid] = d;
  barrier();
  for (uint n = AJP_GROUP_SIZE / 2u; n > 0u; n >>= 1u) {
    if (tid < n) partial[tid] += partial[tid + n];
    barrier();
  }
  if (tid == 0u) partials.sum[gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x] = partial[0];
}
