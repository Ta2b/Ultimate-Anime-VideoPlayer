#version 450
// Softmax splatting de GMFSS, seconde passe : chaque plan accumulé par gmfss_splat.comp divisé
// par le poids accumulé (dernier plan) + kGmfssNormalizeEpsilon. Un pixel que rien n'atteint vaut 0.
// Référence : kernels/ref/gmfss.cpp (soft_splat) ; même calcul que gmfss_kernels.cu.
#extension GL_GOOGLE_include_directive : require
#include "tensor.glsl"
#include "ajp_kernels_spec.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer Sums { float v[]; } sums;  // channels + 1 plans
layout(std430, binding = 1) writeonly buffer Out { AJP_TENSOR v[]; } dst;

layout(push_constant) uniform Push {
  uint width;
  uint height;
  uint channels;
} pc;

void main() {
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  if (x >= pc.width || y >= pc.height) return;
  uint plane = pc.width * pc.height;
  uint i = y * pc.width + x;
  float total = sums.v[pc.channels * plane + i] + AJP_GMFSS_NORMALIZE_EPSILON;
  for (uint c = 0u; c < pc.channels; ++c) dst.v[c * plane + i] = AJP_TENSOR(sums.v[c * plane + i] / total);
}
