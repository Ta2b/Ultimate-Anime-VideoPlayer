#version 450
// Chaque élément d'un tenseur prend la même valeur (gpu/kernel_ops.h, fill) : l'instant t que
// reçoit le graphe « fusion » de GMFSS Fortuna Union. Même calcul que gmfss_kernels.cu (fill).
#extension GL_GOOGLE_include_directive : require
#include "tensor.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) writeonly buffer Out { AJP_TENSOR v[]; } dst;

layout(push_constant) uniform Push {
  uint count;
  float value;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < pc.count) dst.v[i] = AJP_TENSOR(pc.value);
}
