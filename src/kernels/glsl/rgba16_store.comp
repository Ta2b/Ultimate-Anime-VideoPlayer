#version 450
// Sortie du ring : le tenseur RGB vers une image RGBA16 UNORM, alpha opaque. L'image se lie
// par une vue R16G16B16A16_UINT : les codes unorm16 de spec/color.h s'écrivent exactement,
// sans la conversion flottante du matériel (arrondi laissé libre par Vulkan).
// Référence : kernels/ref/color.cpp (to_rgba16).
#extension GL_GOOGLE_include_directive : require
#include "tensor.glsl"
#include "ajp_kernels_spec.glsl"
#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer Rgb { AJP_TENSOR v[]; } rgb;
layout(binding = 1, rgba16ui) uniform writeonly uimage2D image;

layout(push_constant) uniform Push {
  uint width;
  uint height;
} pc;

void main() {
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  if (x >= pc.width || y >= pc.height) return;
  uint plane = pc.width * pc.height;
  uint i = y * pc.width + x;
  uvec4 codes = uvec4(unorm16(float(rgb.v[i])), unorm16(float(rgb.v[plane + i])),
                      unorm16(float(rgb.v[2u * plane + i])), AJP_OPAQUE_ALPHA16);
  imageStore(image, ivec2(x, y), codes);
}
