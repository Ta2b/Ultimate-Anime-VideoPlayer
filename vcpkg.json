{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "ajp",
  "version-semver": "0.11.0",
  "builtin-baseline": "65886d79ccce671dc24ffbf9a348836beacb7f6f",
  "dependencies": [
    "tomlplusplus",
    "zlib",
    {
      "name": "spdlog",
      "default-features": false
    }
  ],
  "features": {
    "tests": {
      "description": "Tests unitaires",
      "dependencies": [
        "catch2"
      ]
    },
    "player": {
      "description": "Le lecteur complet : médias, rendu, interface",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avfilter",
            "avformat",
            "swresample",
            "swscale",
            "dav1d",
            "zlib",
            "nvcodec",
            "vulkan",
            {
              "name": "amf",
              "platform": "windows"
            },
            {
              "name": "qsv",
              "platform": "windows"
            },
            {
              "name": "svt-av1",
              "platform": "x64"
            }
          ]
        },
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ]
        },
        "libplacebo",
        "libass",
        {
          "name": "imgui",
          "features": [
            "freetype"
          ]
        },
        "vulkan-headers",
        {
          "name": "shaderc",
          "host": true
        },
        {
          "name": "spirv-tools",
          "host": true,
          "features": [
            "tools"
          ]
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "ffmpeg",
      "version": "9.0.2",
      "port-version": 6
    },
    {
      "name": "sdl3",
      "version": "3.4.20",
      "port-version": 0
    },
    {
      "name": "spdlog",
      "version": "1.17.0",
      "port-version": 1
    },
    {
      "name": "tomlplusplus",
      "version": "3.4.0",
      "port-version": 1
    },
    {
      "name": "imgui",
      "version": "1.93.0",
      "port-version": 0
    },
    {
      "name": "vulkan-headers",
      "version": "1.4.363.0",
      "port-version": 0
    }
  ],
  "default-features": [
    "tests"
  ],
  "description": "Lecteur vidéo anime : upscaling, interpolation et HDR en temps réel"
}
