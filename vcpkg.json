{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "ajp",
  "version-semver": "0.10.3",
  "builtin-baseline": "ec48c11eae9448c8c6e7739d93e06fa2433aa95f",
  "dependencies": [
    "tomlplusplus",
    "zlib",
    {
      "name": "spdlog",
      "default-features": false
    }
  ],
  "features": {
    "tests": {
      "description": "Tests unitaires",
      "dependencies": [
        "catch2"
      ]
    },
    "player": {
      "description": "Le lecteur complet : médias, rendu, interface",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avfilter",
            "avformat",
            "swresample",
            "swscale",
            "dav1d",
            "nvcodec",
            "vulkan",
            {
              "name": "amf",
              "platform": "windows"
            },
            {
              "name": "qsv",
              "platform": "windows"
            },
            {
              "name": "svt-av1",
              "platform": "x64"
            }
          ]
        },
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ]
        },
        "libplacebo",
        "libass",
        {
          "name": "imgui",
          "features": [
            "sdl3-binding",
            "vulkan-binding"
          ]
        },
        "vulkan-headers",
        "nanobench",
        {
          "name": "shaderc",
          "host": true
        }
      ]
    }
  },
  "default-features": [
    "tests"
  ],
  "description": "Lecteur vidéo anime : upscaling, interpolation et HDR en temps réel"
}
