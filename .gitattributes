# Les scripts bash restent en LF, même extraits sous Windows (core.autocrlf des runners).
*.sh text eol=lf

# Le corpus du fuzz : des octets exacts, jamais convertis en CRLF.
tests/fuzz/corpus/** -text

# Les LUT 3D .cube (data/luts) : des octets exacts, jamais convertis (fins de ligne CRLF de Resolve).
data/luts/*.cube -text

# Les hooks mpv (src/render/shaders) : en LF partout ; grade.cpp cherche ses marques suivies de « \n ».
*.hook text eol=lf

# Les correctifs de ports/ (lus par git apply, côté vcpkg et côté linux-from-source.sh) et les scripts CMake : en LF
# partout. Avec core.autocrlf=true (réglage par défaut de Git pour Windows), un correctif sortait en CRLF et ses lignes
# ajoutaient un retour chariot aux sources de libass et de libplacebo (un fichier de symboles, un script meson).
*.patch text eol=lf
*.cmake text eol=lf
