# Versions et paquets Ubuntu 24.04 communs à .github/workflows/ci.yml, cloud.yml, release-linux.yml
# et au préflight (tools/release/preflight) : une seule liste, lue par « source » dans les workflows
# et copiée dans l'image Docker ; release-windows.yml y lit OPENVINO_VERSION, tools/deps/windows-winml.ps1
# WINML_VERSION et WINML_SHA256. Une version change ici
# et nulle part ailleurs.

# Moteurs facultatifs du paquet Linux : OpenVINO par sa roue PyPI (manylinux_2_28, ABI C++11 ;
# la 2025.3, manylinux2014, impose _GLIBCXX_USE_CXX11_ABI=0), MIGraphX par le dépôt ROCm d'AMD.
OPENVINO_VERSION=2026.4.1
ROCM_VERSION=7.2
# Meson, qui construit libplacebo (tools/deps/linux-from-source.sh), par pip.
MESON_VERSION=1.12.1

# Outils de construction (toutes les tâches ; les compilateurs viennent de l'image du runner).
APT_BUILD="ninja-build nasm autoconf automake libtool pkg-config python3-jinja2"
# Ce que tools/deps/linux-from-source.sh et le lecteur demandent au système : Vulkan et ses
# outils de shaders, polices, codecs, son, réseau, X11, Wayland, DRM et VA-API.
APT_PLAYER="libvulkan-dev glslc glslang-tools spirv-tools
  libfreetype-dev libharfbuzz-dev libfribidi-dev libfontconfig-dev libshaderc-dev glslang-dev
  liblcms2-dev libdav1d-dev libasound2-dev libpulse-dev
  libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxss-dev libxtst-dev
  libxfixes-dev libxinerama-dev libxkbcommon-dev libxkbcommon-x11-dev libwayland-dev
  wayland-protocols libdecor-0-dev libdrm-dev libgbm-dev libegl-dev libudev-dev libdbus-1-dev
  libva-dev"
# Tests sans GPU : Vulkan logiciel (lavapipe), la couche de validation et Xvfb.
APT_TESTS="mesa-vulkan-drivers vulkan-tools vulkan-validationlayers xvfb xauth"
# Paquet livré (tools/release/package-linux.sh).
APT_PACKAGE="patchelf p7zip-full"
# MIGraphX de Windows ML (moteur à l'essai des AMD RDNA 3 et après, sous Windows) : le paquet
# NuGet Microsoft.Windows.AI.MachineLearning, ses en-têtes et ses DLL redistribuables
# (onnxruntime.dll, Microsoft.Windows.AI.MachineLearning.dll), vérifié par son empreinte
# (tools/deps/windows-winml.ps1).
WINML_VERSION=2.4.89
WINML_SHA256=5c68ecfb947223267abf159a023f5192ad42725e4e9cc995e7c1470dd54dff63
# TensorRT de Windows (moteur NVIDIA), construit par release-windows.yml seulement quand son entrée
# tensorrt le demande : le propriétaire du dépôt y accepte la licence du kit CUDA et celle de
# TensorRT (tools/deps/windows-tensorrt.ps1). Le kit CUDA vient des archives redist de NVIDIA,
# de la dernière 13.4.x publiée ; TensorRT, du zip que nomme le README de NVIDIA/TensorRT 11.3.
CUDA_REDIST_SERIES=13.4
TENSORRT_WINDOWS_URL=https://developer.nvidia.com/downloads/compute/machine-learning/tensorrt/11.3.0/zip/TensorRT-Enterprise-11.3.0.99-Windows-amd64-cuda-13.4-Release-external.zip
