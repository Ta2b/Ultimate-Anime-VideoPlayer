# Les avertissements sont des erreurs en CI.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cppcoreguidelines-avoid-non-const-global-variables,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-slicing,
  misc-const-correctness,
  misc-unused-using-decls,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-*,
  -performance-enum-size,
  readability-container-size-empty,
  readability-function-cognitive-complexity,
  readability-function-size,
  readability-make-member-function-const,
  readability-redundant-*,
WarningsAsErrors: '*'
HeaderFilterRegex: 'src/.*'
# Complexité (P5.17) : aucune fonction nouvelle au-delà de ces bornes ; les fonctions qui les dépassent
# déjà portent un NOLINTNEXTLINE, à retirer quand elles sont découpées (P5.15), jamais à ajouter.
# Un std::expected ignoré est une erreur (P5.7) : bugprone-unused-return-value le vérifie sur le type de
# résultat, plus sûr qu'un [[nodiscard]] à poser sur 765 fonctions ; MSVC marque std::expected
# [[nodiscard]] de lui-même. std::ignore = … dit qu'un résultat est volontairement laissé.
CheckOptions:
  - key: bugprone-unused-return-value.CheckedReturnTypes
    value: '^::std::error_code$;^::std::error_condition$;^::std::errc$;^::std::expected$'
  - key: readability-function-cognitive-complexity.Threshold
    value: 60
  - key: readability-function-size.LineThreshold
    value: 200
  - key: misc-const-correctness.AnalyzeValues
    value: false
