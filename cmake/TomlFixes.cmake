# toml++ 3.4.0, la dernière version publiée, avec quatre correctifs d'analyse : trois de sa branche
# master (réécrits ici, pas recopiés : le dépôt ne tire aucun code amont non publié) et un qu'elle
# n'a pas encore. Sans eux, un fichier mal formé mène à un comportement indéfini, que tests/fuzz
# retrouve :
#   - un en-tête de table qui ne commence pas par un caractère de clé (« [ = ») viole la
#     précondition de parse_key (marzer/tomlplusplus#301) ;
#   - is_non_ascii_horizontal_whitespace atteint TOML_UNREACHABLE pour un caractère non ASCII
#     qui n'est pas un espace, « é » par exemple (#305) ;
#   - une clé pointée sans limite de profondeur épuise la pile (#242, limite 1024 comme en amont) ;
#   - un élément de tableau qui commence par « } » (« [1, }2] ») viole la précondition de
#     parse_value : le tableau ne vérifie pas ce que vérifie une paire clé-valeur (pas encore
#     corrigé en amont, master du 2026-07-21).
# La quatrième, la profondeur des valeurs imbriquées ramenée de 256 à 128 (#293), est un réglage :
# src/core/toml_config.h la pose, avec le reste de la configuration.
#
# Les en-têtes sont recopiés sous le dossier de build, dans toml++-ajp/, et corrigés là au
# configure : le même code sur toutes les plateformes, que toml++ vienne de vcpkg ou du préfixe.
# Le nom distinct fait que <toml++-ajp/toml.hpp> ne trouve jamais une autre copie, quel que soit
# l'ordre des chemins de recherche ; toml_config.h refuse une inclusion de <toml++/toml.hpp>.
# Une version de toml++ qui n'a plus le code corrigé arrête le configure : ce correctif est alors
# à revoir, probablement à retirer.
include_guard(GLOBAL)

# Remplace l'unique occurrence de before, après la première occurrence de after_anchor (le début
# du texte si vide), par replacement.
function(_ajp_toml_fix text_var file after_anchor before replacement)
  set(text "${${text_var}}")
  set(start 0)
  if(NOT after_anchor STREQUAL "")
    string(FIND "${text}" "${after_anchor}" start)
    if(start EQUAL -1)
      message(FATAL_ERROR "toml++ : « ${after_anchor} » introuvable dans ${file} (cmake/TomlFixes.cmake)")
    endif()
  endif()
  string(SUBSTRING "${text}" 0 ${start} head)
  string(SUBSTRING "${text}" ${start} -1 tail)
  string(FIND "${tail}" "${before}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "toml++ : ${file} n'a plus le code que corrige cmake/TomlFixes.cmake")
  endif()
  string(LENGTH "${before}" length)
  string(SUBSTRING "${tail}" 0 ${at} kept)
  math(EXPR rest "${at} + ${length}")
  string(SUBSTRING "${tail}" ${rest} -1 after)
  if(after_anchor STREQUAL "")
    string(FIND "${after}" "${before}" again)
    if(NOT again EQUAL -1)
      message(FATAL_ERROR "toml++ : le code à corriger paraît deux fois dans ${file}")
    endif()
  endif()
  set(${text_var} "${head}${kept}${replacement}${after}" PARENT_SCOPE)
endfunction()

# out_var : le dossier à inclure, qui contient toml++-ajp/toml.hpp.
function(ajp_toml_fixed_include source_dirs out_var)
  set(source "")
  foreach(dir IN LISTS source_dirs)
    if(EXISTS "${dir}/toml++/toml.hpp")
      set(source "${dir}/toml++")
      break()
    endif()
  endforeach()
  if(source STREQUAL "")
    message(FATAL_ERROR "toml++ : toml++/toml.hpp introuvable dans ${source_dirs}")
  endif()
  set(root "${CMAKE_BINARY_DIR}/toml-fixed")
  set(dest "${root}/toml++-ajp")

  file(GLOB_RECURSE headers RELATIVE "${source}" CONFIGURE_DEPENDS "${source}/*.hpp" "${source}/*.inl"
       "${source}/*.h")
  foreach(header IN LISTS headers)
    file(READ "${source}/${header}" text)
    if(header STREQUAL "toml.hpp")
      # La marque que toml_config.h exige : cette copie, pas celle d'origine.
      set(text "#define AJP_TOML_FIXED 1\n${text}")
    elseif(header STREQUAL "impl/parser.inl")
      _ajp_toml_fix(text "${header}" ""
        [==["tables with blank bare keys are explicitly prohibited"sv);]==]
        [==["tables with blank bare keys are explicitly prohibited"sv);
        if (!is_bare_key_character(*cp) && !is_string_delimiter(*cp))
          set_error_and_return_default("expected bare key starting character or string delimiter, saw '"sv,
                                       to_sv(*cp), "'"sv);]==])
      _ajp_toml_fix(text "${header}" ""
        [==[key_buffer.push_back(key_segment, key_begin, key_end);]==]
        [==[key_buffer.push_back(key_segment, key_begin, key_end);
        if TOML_UNLIKELY(key_buffer.size() > 1024u)
          set_error_and_return_default("exceeded maximum dotted keys depth of 1024"sv);]==])
      _ajp_toml_fix(text "${header}" ""
        [==[auto val = parse_value();]==]
        [==[if (is_value_terminator(*cp))
          set_error_and_return_default("expected value, saw '"sv, to_sv(*cp), "'"sv);
        auto val = parse_value();]==])
    elseif(header STREQUAL "impl/unicode_autogenerated.hpp")
      _ajp_toml_fix(text "${header}" "is_non_ascii_horizontal_whitespace(char32_t c)"
        [==[default: TOML_UNREACHABLE;]==] [==[default: return false;]==])
    endif()
    # Réécrit seulement ce qui change : un configure ne recompile pas tout ce qui lit toml++.
    set(out "${dest}/${header}")
    set(old "")
    if(EXISTS "${out}")
      file(READ "${out}" old)
    endif()
    if(NOT old STREQUAL text)
      file(WRITE "${out}" "${text}")
    endif()
    set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}/${header}")
  endforeach()
  set(${out_var} "${root}" PARENT_SCOPE)
endfunction()
